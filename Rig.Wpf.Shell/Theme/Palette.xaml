<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Palette luxueuse — inspirée des dashboards editoriaux modernes.
        Surface = pearl → blanc → marine profond
        Brand   = bleu Marianne profond avec gradient pour les actions premium
        Accent  = champagne or pour highlights / sélections premium
        Status  = success / warning / danger / info
    -->

    <!-- ============ SURFACES ============ -->
    <Color x:Key="Surface0">#F4F6FA</Color>
    <Color x:Key="Surface1">#FFFFFF</Color>
    <Color x:Key="Surface2">#EEF1F6</Color>
    <Color x:Key="Surface3">#E2E7F0</Color>

    <Color x:Key="Marine900">#0E1A30</Color>
    <Color x:Key="Marine800">#15243F</Color>
    <Color x:Key="Marine700">#1B2D4D</Color>
    <Color x:Key="Marine600">#22365C</Color>
    <Color x:Key="Marine500">#2A4276</Color>
    <Color x:Key="MarineGlow">#3B5FA0</Color>

    <Color x:Key="SurfaceInverse">#0E1A30</Color>

    <!-- ============ BRAND ============ -->
    <Color x:Key="Brand500">#1F3B66</Color>
    <Color x:Key="Brand600">#16294A</Color>
    <Color x:Key="Brand400">#3B5B8A</Color>
    <Color x:Key="Brand300">#6B85B5</Color>
    <Color x:Key="Brand100">#DCE6F4</Color>
    <Color x:Key="Brand50">#F1F5FB</Color>

    <!-- ============ ACCENT (champagne or) ============ -->
    <Color x:Key="Accent700">#8A6A2C</Color>
    <Color x:Key="Accent500">#C9A961</Color>
    <Color x:Key="Accent400">#D7BC85</Color>
    <Color x:Key="Accent200">#EEDFBC</Color>
    <Color x:Key="Accent100">#FBF3E0</Color>
    <Color x:Key="Accent50">#FDF9EF</Color>

    <!-- ============ STATUS ============ -->
    <Color x:Key="Success500">#1E8E5A</Color>
    <Color x:Key="Success100">#DDF3E8</Color>
    <Color x:Key="Warning500">#B5781A</Color>
    <Color x:Key="Warning100">#FBEBC9</Color>
    <Color x:Key="Danger500">#C0392B</Color>
    <Color x:Key="Danger100">#F8DAD5</Color>
    <Color x:Key="Info500">#2C6FB0</Color>
    <Color x:Key="Info100">#DCE9F6</Color>

    <!-- ============ TEXTES ============ -->
    <Color x:Key="TextPrimary">#0E1A30</Color>
    <Color x:Key="TextSecondary">#475569</Color>
    <Color x:Key="TextMuted">#8190A4</Color>
    <Color x:Key="TextInverse">#F4F6FA</Color>
    <Color x:Key="TextInverseSecondary">#A8B6CC</Color>
    <Color x:Key="TextDisabled">#B0BAC6</Color>

    <!-- ============ BORDURES ============ -->
    <Color x:Key="Border100">#E4E8EF</Color>
    <Color x:Key="Border200">#CDD5DF</Color>
    <Color x:Key="Border300">#9CA8B6</Color>
    <Color x:Key="BorderFocus">#3B5B8A</Color>
    <Color x:Key="BorderFocusAccent">#C9A961</Color>

    <!-- ============ BRUSHES PLATS ============ -->
    <SolidColorBrush x:Key="Surface0Brush" Color="{StaticResource Surface0}" />
    <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2}" />
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3}" />
    <SolidColorBrush x:Key="SurfaceInverseBrush" Color="{StaticResource SurfaceInverse}" />

    <SolidColorBrush x:Key="Marine900Brush" Color="{StaticResource Marine900}" />
    <SolidColorBrush x:Key="Marine800Brush" Color="{StaticResource Marine800}" />
    <SolidColorBrush x:Key="Marine700Brush" Color="{StaticResource Marine700}" />
    <SolidColorBrush x:Key="Marine600Brush" Color="{StaticResource Marine600}" />
    <SolidColorBrush x:Key="Marine500Brush" Color="{StaticResource Marine500}" />
    <SolidColorBrush x:Key="MarineGlowBrush" Color="{StaticResource MarineGlow}" />

    <SolidColorBrush x:Key="Brand500Brush" Color="{StaticResource Brand500}" />
    <SolidColorBrush x:Key="Brand600Brush" Color="{StaticResource Brand600}" />
    <SolidColorBrush x:Key="Brand400Brush" Color="{StaticResource Brand400}" />
    <SolidColorBrush x:Key="Brand300Brush" Color="{StaticResource Brand300}" />
    <SolidColorBrush x:Key="Brand100Brush" Color="{StaticResource Brand100}" />
    <SolidColorBrush x:Key="Brand50Brush" Color="{StaticResource Brand50}" />

    <SolidColorBrush x:Key="Accent700Brush" Color="{StaticResource Accent700}" />
    <SolidColorBrush x:Key="Accent500Brush" Color="{StaticResource Accent500}" />
    <SolidColorBrush x:Key="Accent400Brush" Color="{StaticResource Accent400}" />
    <SolidColorBrush x:Key="Accent200Brush" Color="{StaticResource Accent200}" />
    <SolidColorBrush x:Key="Accent100Brush" Color="{StaticResource Accent100}" />
    <SolidColorBrush x:Key="Accent50Brush" Color="{StaticResource Accent50}" />

    <SolidColorBrush x:Key="Success500Brush" Color="{StaticResource Success500}" />
    <SolidColorBrush x:Key="Success100Brush" Color="{StaticResource Success100}" />
    <SolidColorBrush x:Key="Warning500Brush" Color="{StaticResource Warning500}" />
    <SolidColorBrush x:Key="Warning100Brush" Color="{StaticResource Warning100}" />
    <SolidColorBrush x:Key="Danger500Brush" Color="{StaticResource Danger500}" />
    <SolidColorBrush x:Key="Danger100Brush" Color="{StaticResource Danger100}" />
    <SolidColorBrush x:Key="Info500Brush" Color="{StaticResource Info500}" />
    <SolidColorBrush x:Key="Info100Brush" Color="{StaticResource Info100}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="TextInverseBrush" Color="{StaticResource TextInverse}" />
    <SolidColorBrush x:Key="TextInverseSecondaryBrush" Color="{StaticResource TextInverseSecondary}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabled}" />

    <SolidColorBrush x:Key="Border100Brush" Color="{StaticResource Border100}" />
    <SolidColorBrush x:Key="Border200Brush" Color="{StaticResource Border200}" />
    <SolidColorBrush x:Key="Border300Brush" Color="{StaticResource Border300}" />
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocus}" />
    <SolidColorBrush x:Key="BorderFocusAccentBrush" Color="{StaticResource BorderFocusAccent}" />

    <!-- ============ BRUSHES GRADIENTS ============ -->

    <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#1B2D4D" />
        <GradientStop Offset="0.4" Color="#15243F" />
        <GradientStop Offset="1" Color="#0E1A30" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#0E1A30" />
        <GradientStop Offset="1" Color="#1B2D4D" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryButtonGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#3B5B8A" />
        <GradientStop Offset="1" Color="#1F3B66" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryButtonGradientHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#1F3B66" />
        <GradientStop Offset="1" Color="#16294A" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentButtonGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#D7BC85" />
        <GradientStop Offset="1" Color="#C9A961" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroIconGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#1B2D4D" />
        <GradientStop Offset="1" Color="#1F3B66" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroIconAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#D7BC85" />
        <GradientStop Offset="1" Color="#8A6A2C" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardSurfaceGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFFFFF" />
        <GradientStop Offset="1" Color="#FDFEFF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="IntroCardGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#F1F5FB" />
        <GradientStop Offset="1" Color="#FDF9EF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="StatusBarGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#F9FAFC" />
        <GradientStop Offset="1" Color="#EEF1F6" />
    </LinearGradientBrush>

    <!-- ============ TYPOGRAPHIE ============ -->
    <FontFamily x:Key="FontFamilyUi">Segoe UI Variable, Segoe UI, Tahoma, Arial</FontFamily>
    <FontFamily x:Key="FontFamilyDisplay">Segoe UI Variable Display, Segoe UI, Tahoma, Arial</FontFamily>
    <FontFamily x:Key="FontFamilyMono">Cascadia Mono, Consolas, monospace</FontFamily>

    <sys:Double x:Key="TextSizeXs"  xmlns:sys="clr-namespace:System;assembly=mscorlib">11</sys:Double>
    <sys:Double x:Key="TextSizeSm"  xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>
    <sys:Double x:Key="TextSizeMd"  xmlns:sys="clr-namespace:System;assembly=mscorlib">13</sys:Double>
    <sys:Double x:Key="TextSizeLg"  xmlns:sys="clr-namespace:System;assembly=mscorlib">15</sys:Double>
    <sys:Double x:Key="TextSizeXl"  xmlns:sys="clr-namespace:System;assembly=mscorlib">18</sys:Double>
    <sys:Double x:Key="TextSize2xl" xmlns:sys="clr-namespace:System;assembly=mscorlib">24</sys:Double>
    <sys:Double x:Key="TextSize3xl" xmlns:sys="clr-namespace:System;assembly=mscorlib">32</sys:Double>
    <sys:Double x:Key="TextSize4xl" xmlns:sys="clr-namespace:System;assembly=mscorlib">42</sys:Double>

    <!-- ============ RADII ============ -->
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">12</CornerRadius>
    <CornerRadius x:Key="RadiusXl">18</CornerRadius>
    <CornerRadius x:Key="Radius2xl">24</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- ============ OMBRES ============ -->
    <DropShadowEffect x:Key="ShadowSm" x:Shared="False"
                      ShadowDepth="1" Direction="270"
                      BlurRadius="6" Opacity="0.08"
                      Color="#1F3B66" />
    <DropShadowEffect x:Key="ShadowMd" x:Shared="False"
                      ShadowDepth="3" Direction="270"
                      BlurRadius="18" Opacity="0.14"
                      Color="#1F3B66" />
    <DropShadowEffect x:Key="ShadowLg" x:Shared="False"
                      ShadowDepth="8" Direction="270"
                      BlurRadius="36" Opacity="0.18"
                      Color="#1F3B66" />
    <DropShadowEffect x:Key="ShadowXl" x:Shared="False"
                      ShadowDepth="16" Direction="270"
                      BlurRadius="56" Opacity="0.24"
                      Color="#1F3B66" />

    <DropShadowEffect x:Key="GlowBrand" x:Shared="False"
                      ShadowDepth="0" Direction="0"
                      BlurRadius="22" Opacity="0.45"
                      Color="#3B5B8A" />

    <DropShadowEffect x:Key="GlowAccent" x:Shared="False"
                      ShadowDepth="0" Direction="0"
                      BlurRadius="22" Opacity="0.40"
                      Color="#C9A961" />

</ResourceDictionary>

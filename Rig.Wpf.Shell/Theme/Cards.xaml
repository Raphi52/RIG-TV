<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Card : surface élevée avec ombre marquée et gradient subtil -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardSurfaceGradient}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border100Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusXl}" />
        <Setter Property="Padding" Value="28" />
        <Setter Property="Effect" Value="{DynamicResource ShadowMd}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="CardElevated" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Effect" Value="{DynamicResource ShadowLg}" />
    </Style>

    <!-- Card intro : fond gradient brand/champagne, vraiment somptueuse -->
    <Style x:Key="CardIntro" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{DynamicResource IntroCardGradient}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent200Brush}" />
    </Style>

    <!-- HeroIconBackdrop : grand cercle gradient marine pour les icônes hero -->
    <Style x:Key="HeroIconBackdrop" TargetType="Border">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="Background" Value="{DynamicResource HeroIconGradient}" />
        <Setter Property="Effect" Value="{DynamicResource ShadowMd}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="HeroIconBackdropAccent" TargetType="Border" BasedOn="{StaticResource HeroIconBackdrop}">
        <Setter Property="Background" Value="{DynamicResource HeroIconAccentGradient}" />
    </Style>

    <!-- Pills (badges arrondis) -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border100Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PillSuccess" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="Background" Value="{DynamicResource Success100Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Success500Brush}" />
    </Style>
    <Style x:Key="PillDanger" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="Background" Value="{DynamicResource Danger100Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Danger500Brush}" />
    </Style>
    <Style x:Key="PillWarning" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="Background" Value="{DynamicResource Warning100Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Warning500Brush}" />
    </Style>
    <Style x:Key="PillInfo" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="Background" Value="{DynamicResource Info100Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Info500Brush}" />
    </Style>
    <Style x:Key="PillBrand" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="Background" Value="{DynamicResource Brand100Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand400Brush}" />
    </Style>
    <Style x:Key="PillAccent" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="Background" Value="{DynamicResource Accent100Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent500Brush}" />
    </Style>

    <!-- Section header : titre + sous-titre -->
    <Style x:Key="SectionHeader" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>

    <!-- ScrollBar minimaliste -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="10" />
                <Setter Property="Width" Value="Auto" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>

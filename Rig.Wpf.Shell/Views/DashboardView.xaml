<UserControl x:Class="Rig.Wpf.Shell.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Rig.Wpf.Shell.ViewModels"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource Surface0Brush}">

    <UserControl.Resources>

        <!-- KPI card : pastille statut + chiffre énorme + label + trend -->
        <Style x:Key="KpiCardStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{DynamicResource Surface1Brush}"
                                BorderBrush="{DynamicResource Border100Brush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusLg}"
                                Effect="{DynamicResource ShadowSm}"
                                Padding="22,20">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Effect" Value="{DynamicResource ShadowMd}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Border200Brush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action card : icone + titre + subtitle + domaine eyebrow -->
        <Style x:Key="ActionCardStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{DynamicResource Surface1Brush}"
                                BorderBrush="{DynamicResource Border100Brush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusLg}"
                                Effect="{DynamicResource ShadowSm}"
                                Padding="22,20">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Effect" Value="{DynamicResource ShadowMd}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brand400Brush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Item liste activité récente -->
        <Style x:Key="RecentItemStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="{DynamicResource Border100Brush}"
                                BorderThickness="0,0,0,1"
                                Padding="0,14">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brand50Brush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Templates KPI : background tinté selon Kind -->
        <DataTemplate x:Key="KpiTemplate">
            <Button Style="{StaticResource KpiCardStyle}" Command="{Binding OpenCommand}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header : icône en pastille colorée + label -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="IconBubble"
                                Grid.Column="0"
                                Width="36" Height="36"
                                CornerRadius="10"
                                Background="{DynamicResource Info100Brush}"
                                VerticalAlignment="Center">
                            <Path Data="{Binding IconKey, Converter={x:Static vm:IconKeyToGeometryConverter.Instance}}"
                                  x:Name="IconPath"
                                  Stroke="{DynamicResource Info500Brush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent"
                                  Width="18" Height="18"
                                  Stretch="Uniform" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Label}"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource TextSizeSm}"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </Grid>

                    <!-- Valeur géante -->
                    <TextBlock Grid.Row="1"
                               Text="{Binding Value}"
                               Margin="0,18,0,4"
                               FontFamily="{DynamicResource FontFamilyDisplay}"
                               FontSize="{DynamicResource TextSize3xl}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <!-- Trend -->
                    <TextBlock Grid.Row="2"
                               Text="{Binding Trend}"
                               FontSize="{DynamicResource TextSizeSm}"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </Grid>

                <Button.Resources>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="success">
                                <Setter Property="Background" Value="{DynamicResource Success100Brush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="warning">
                                <Setter Property="Background" Value="{DynamicResource Warning100Brush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="error">
                                <Setter Property="Background" Value="{DynamicResource Danger100Brush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Resources>
            </Button>
        </DataTemplate>

        <!-- Template action card -->
        <DataTemplate x:Key="ActionTemplate">
            <Button Command="{Binding OpenCommand}" MinHeight="140"
                    Style="{StaticResource ActionCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding Domain}"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Accent700Brush}"
                               Margin="0,0,0,12" />

                    <Border Grid.Row="1"
                            Style="{StaticResource HeroIconBackdrop}"
                            Width="44" Height="44"
                            CornerRadius="14"
                            HorizontalAlignment="Left">
                        <Path Data="{Binding IconKey, Converter={x:Static vm:IconKeyToGeometryConverter.Instance}}"
                              Stroke="{DynamicResource Accent400Brush}"
                              StrokeThickness="1.8"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              Width="22" Height="22"
                              Stretch="Uniform" />
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,16,0,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Title}"
                                   FontFamily="{DynamicResource FontFamilyDisplay}"
                                   FontSize="{DynamicResource TextSizeXl}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Subtitle}"
                                   Margin="0,4,0,0"
                                   FontSize="{DynamicResource TextSizeSm}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock Text="Ouvrir"
                                   FontSize="{DynamicResource TextSizeSm}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brand500Brush}"
                                   VerticalAlignment="Center" />
                        <Path Data="{DynamicResource IconArrowRight}"
                              Stroke="{DynamicResource Brand500Brush}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              Margin="6,0,0,0"
                              VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Template recent item -->
        <DataTemplate x:Key="RecentTemplate">
            <Button Style="{StaticResource RecentItemStyle}" Command="{Binding OpenCommand}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="36" Height="36"
                            CornerRadius="10"
                            Background="{DynamicResource Brand50Brush}"
                            VerticalAlignment="Center">
                        <Path Data="{Binding IconKey, Converter={x:Static vm:IconKeyToGeometryConverter.Instance}}"
                              Stroke="{DynamicResource Brand500Brush}"
                              StrokeThickness="1.6"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              Width="16" Height="16"
                              Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}"
                                   FontSize="{DynamicResource TextSizeMd}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding SubLabel}"
                                   FontSize="{DynamicResource TextSizeSm}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="{Binding TimeLabel}"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource TextSizeXs}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="48,40,48,48" MaxWidth="1280" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><!-- HERO -->
                <RowDefinition Height="Auto" /><!-- KPIs -->
                <RowDefinition Height="Auto" /><!-- Quick actions -->
                <RowDefinition Height="Auto" /><!-- Recent activity -->
            </Grid.RowDefinitions>

            <!-- ============ HERO ============ -->
            <Grid Grid.Row="0" Margin="0,0,0,36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="64" Height="64"
                        CornerRadius="32"
                        Background="{DynamicResource HeroIconAccentGradient}"
                        Effect="{DynamicResource ShadowMd}"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding UserInitials}"
                               FontFamily="{DynamicResource FontFamilyDisplay}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#0E1A30"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock>
                        <Run Text="{Binding Greeting, Mode=OneWay}"
                             FontFamily="{DynamicResource FontFamilyDisplay}"
                             FontSize="{DynamicResource TextSize3xl}"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}" /><Run Text=", "
                             FontFamily="{DynamicResource FontFamilyDisplay}"
                             FontSize="{DynamicResource TextSize3xl}"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}" /><Run Text="{Binding UserName, Mode=OneWay}"
                             FontFamily="{DynamicResource FontFamilyDisplay}"
                             FontSize="{DynamicResource TextSize3xl}"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource Brand500Brush}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding GreffeLabel}"
                                   FontSize="{DynamicResource TextSizeMd}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Rectangle Width="3" Height="3" Margin="12,0"
                                   Fill="{DynamicResource Border300Brush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TodayLabel}"
                                   FontSize="{DynamicResource TextSizeMd}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="2"
                        Style="{StaticResource PillAccent}"
                        VerticalAlignment="Center"
                        Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8"
                                 Fill="{DynamicResource Success500Brush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0" />
                        <TextBlock Text="EN SERVICE"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Accent700Brush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ KPIs ============ -->
            <ItemsControl Grid.Row="1"
                          ItemsSource="{Binding Kpis}"
                          ItemTemplate="{StaticResource KpiTemplate}"
                          Margin="0,0,0,40">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="0,0,16,0" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>

            <!-- ============ QUICK ACTIONS ============ -->
            <StackPanel Grid.Row="2" Margin="0,0,0,40">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="ACCÈS RAPIDES"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Accent700Brush}"
                               VerticalAlignment="Center" />
                    <Rectangle Width="40" Height="1"
                               Fill="{DynamicResource Border200Brush}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding QuickActions}"
                              ItemTemplate="{StaticResource ActionTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="0,0,16,16" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </StackPanel>

            <!-- ============ ACTIVITÉ RÉCENTE ============ -->
            <Border Grid.Row="3"
                    Background="{DynamicResource Surface1Brush}"
                    BorderBrush="{DynamicResource Border100Brush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusLg}"
                    Effect="{DynamicResource ShadowSm}"
                    Padding="28,20,28,8">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ACTIVITÉ RÉCENTE"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Accent700Brush}"
                                       VerticalAlignment="Center" />
                            <Rectangle Width="40" Height="1"
                                       Fill="{DynamicResource Border200Brush}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="Mock · démo"
                                   FontSize="{DynamicResource TextSizeXs}"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Recent}"
                                  ItemTemplate="{StaticResource RecentTemplate}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

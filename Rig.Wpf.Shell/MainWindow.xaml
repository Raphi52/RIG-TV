<Window x:Class="Rig.Wpf.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Rig.Wpf.Shell.ViewModels"
        xmlns:views="clr-namespace:Rig.Wpf.Shell.Views"
        Title="RIG — Registre Informatisé des Greffes"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="Manual"
        Background="{DynamicResource Surface0Brush}"
        FontFamily="{DynamicResource FontFamilyUi}"
        d:DataContext="{d:DesignInstance vm:ShellViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <Window.Resources>
        <!-- Style sub-item nav (cliquable, ouvre un tab) -->
        <Style x:Key="NavSubItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextInverseSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="32,8,12,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RadiusMd}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F3052" />
                                <Setter Property="Foreground" Value="{DynamicResource TextInverseBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style group header (Expander toggle button) -->
        <Style x:Key="NavGroupExpanderStyle" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextInverseBrush}" />
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderSite"
                                          IsChecked="{Binding IsExpanded,
                                              RelativeSource={RelativeSource TemplatedParent},
                                              Mode=TwoWay}"
                                          Cursor="Hand"
                                          Background="Transparent"
                                          BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HdrBd"
                                                Background="Transparent"
                                                CornerRadius="{DynamicResource RadiusMd}"
                                                Padding="12,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  ContentSource="Content"
                                                                  VerticalAlignment="Center" />
                                                <Path x:Name="ChevronPath"
                                                      Grid.Column="2"
                                                      Data="{DynamicResource IconChevronRight}"
                                                      Stroke="{DynamicResource TextInverseSecondaryBrush}"
                                                      StrokeThickness="2"
                                                      Fill="Transparent"
                                                      Width="10" Height="10"
                                                      Stretch="Uniform"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="0" />
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ChevronPath" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HdrBd" Property="Background" Value="#1A2842" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter ContentSource="Header" />
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite"
                                              Visibility="Collapsed"
                                              Margin="0,2,0,8" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================ SIDEBAR ================ -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarGradient}"
                Effect="{DynamicResource ShadowLg}">
            <DockPanel LastChildFill="True">
                <!-- Brand (cliquable : retour accueil) -->
                <Border DockPanel.Dock="Top" Padding="14,18,14,12"
                        BorderBrush="#22335A"
                        BorderThickness="0,0,0,1">
                    <Button Command="{Binding GoHomeCommand}"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="10,6"
                            HorizontalContentAlignment="Left"
                            ToolTip="Retour à l'accueil">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="Transparent"
                                        CornerRadius="{DynamicResource RadiusMd}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#1A2842" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40"
                                    CornerRadius="12"
                                    Background="{DynamicResource HeroIconAccentGradient}"
                                    Effect="{DynamicResource ShadowMd}">
                                <TextBlock Text="R"
                                           FontFamily="{DynamicResource FontFamilyDisplay}"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="#0E1A30"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="RIG"
                                           FontFamily="{DynamicResource FontFamilyDisplay}"
                                           FontSize="20" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextInverseBrush}" />
                                <TextBlock Text="Greffes des tribunaux"
                                           FontSize="10"
                                           Foreground="{DynamicResource Accent400Brush}"
                                           FontWeight="SemiBold"
                                           Margin="0,-2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Greffe selector -->
                <Border DockPanel.Dock="Top" Padding="20,14,20,4">
                    <Border CornerRadius="{DynamicResource RadiusMd}"
                            Background="#1A2842"
                            BorderBrush="#22335A"
                            BorderThickness="1"
                            Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="BASE DE DONNÉES"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Accent500Brush}"
                                       Opacity="0.9" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding Session.BaseDatabase}"
                                           FontFamily="{DynamicResource FontFamilyMono}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextInverseBrush}"
                                           VerticalAlignment="Center" />
                                <Border Background="{DynamicResource Success500Brush}"
                                        Width="6" Height="6"
                                        CornerRadius="3"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding Session.BaseServer}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextInverseSecondaryBrush}"
                                       Margin="0,3,0,0" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextInverseSecondaryBrush}">
                                <Run Text="Greffe" /> <Run Text="{Binding Session.GreffeCode, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- Status bar bottom -->
                <Border DockPanel.Dock="Bottom" Padding="20,16,20,18"
                        BorderBrush="#22335A"
                        BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32"
                                CornerRadius="16"
                                Background="{DynamicResource Brand400Brush}">
                            <TextBlock Text="{Binding Session.UserInitials}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextInverseBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Session.UserName}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextInverseBrush}" />
                            <TextBlock Text="{Binding Session.UserRole}"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextInverseSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Navigation : groupes de modules -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,10,12,12">

                        <TextBlock Text="NAVIGATION"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Accent500Brush}"
                                   Opacity="0.8"
                                   Margin="12,4,0,4" />

                        <!-- ===== JUDICIAIRE ===== -->
                        <Expander Style="{StaticResource NavGroupExpanderStyle}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{DynamicResource IconScale}"
                                          Stroke="{DynamicResource TextInverseBrush}"
                                          StrokeThickness="1.8"
                                          Fill="Transparent"
                                          Width="15" Height="15"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Judiciaire"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextInverseBrush}"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <Button Style="{StaticResource NavSubItem}"
                                        Content="Instances"
                                        Command="{Binding OpenTabCommand}"
                                        CommandParameter="DEMO_JUD_INSTANCE" />
                                <Button Style="{StaticResource NavSubItem}"
                                        Content="Audiences"
                                        Command="{Binding OpenTabCommand}"
                                        CommandParameter="DEMO_JUD_AUDIENCE" />
                                <Button Style="{StaticResource NavSubItem}"
                                        Content="Décisions"
                                        Command="{Binding OpenTabCommand}"
                                        CommandParameter="DEMO_JUD_DECISION" />
                                <Button Style="{StaticResource NavSubItem}"
                                        Content="Parties"
                                        Command="{Binding OpenTabCommand}"
                                        CommandParameter="DEMO_JUD_PARTIES" />
                                <Button Style="{StaticResource NavSubItem}"
                                        Content="Mandataires ★"
                                        ToolTip="Module fonctionnel branché en base"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Accent400Brush}"
                                        Command="{Binding OpenTabCommand}"
                                        CommandParameter="MANDATAIRE" />
                            </StackPanel>
                        </Expander>

                        <!-- ===== RCS ===== -->
                        <Expander Style="{StaticResource NavGroupExpanderStyle}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{DynamicResource IconBriefcase}"
                                          Stroke="{DynamicResource TextInverseBrush}"
                                          StrokeThickness="1.8"
                                          Fill="Transparent"
                                          Width="15" Height="15"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="RCS"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextInverseBrush}"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <Button Style="{StaticResource NavSubItem}" Content="Sociétés"
                                        Command="{Binding OpenTabCommand}" CommandParameter="DEMO_RCS_SOCIETE" />
                                <Button Style="{StaticResource NavSubItem}" Content="Dirigeants"
                                        Command="{Binding OpenTabCommand}" CommandParameter="DEMO_RCS_DIRIGEANT" />
                                <Button Style="{StaticResource NavSubItem}" Content="Actes déposés"
                                        Command="{Binding OpenTabCommand}" CommandParameter="DEMO_RCS_ACTE" />
                                <Button Style="{StaticResource NavSubItem}" Content="Éditions K-bis"
                                        Command="{Binding OpenTabCommand}" CommandParameter="KBIS" />
                            </StackPanel>
                        </Expander>

                        <!-- ===== INSCRIPTIONS ===== -->
                        <Expander Style="{StaticResource NavGroupExpanderStyle}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{DynamicResource IconLock}"
                                          Stroke="{DynamicResource TextInverseBrush}"
                                          StrokeThickness="1.8"
                                          Fill="Transparent"
                                          Width="15" Height="15"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Inscriptions"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextInverseBrush}"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <Button Style="{StaticResource NavSubItem}" Content="Privilèges"
                                        Command="{Binding OpenTabCommand}" CommandParameter="DEMO_INS_PRIVILEGE" />
                                <Button Style="{StaticResource NavSubItem}" Content="Nantissements"
                                        Command="{Binding OpenTabCommand}" CommandParameter="DEMO_INS_NANTISSEMENT" />
                            </StackPanel>
                        </Expander>

                        <!-- ===== COMPTABILITÉ ===== -->
                        <Expander Style="{StaticResource NavGroupExpanderStyle}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{DynamicResource IconUserGroup}"
                                          Stroke="{DynamicResource TextInverseBrush}"
                                          StrokeThickness="1.8"
                                          Fill="Transparent"
                                          Width="15" Height="15"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Comptabilité"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextInverseBrush}"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <Button Style="{StaticResource NavSubItem}" Content="Comptes clients"
                                        Command="{Binding OpenTabCommand}" CommandParameter="DEMO_COMPTA_CLIENT" />
                                <Button Style="{StaticResource NavSubItem}" Content="Factures"
                                        Command="{Binding OpenTabCommand}" CommandParameter="DEMO_COMPTA_FACTURE" />
                                <Button Style="{StaticResource NavSubItem}" Content="Encaissements"
                                        Command="{Binding OpenTabCommand}" CommandParameter="DEMO_COMPTA_ENCAISSEMENT" />
                            </StackPanel>
                        </Expander>

                        <!-- ===== EDI / FLUX ===== -->
                        <Expander Style="{StaticResource NavGroupExpanderStyle}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{DynamicResource IconArrowDown}"
                                          Stroke="{DynamicResource TextInverseBrush}"
                                          StrokeThickness="1.8"
                                          Fill="Transparent"
                                          Width="15" Height="15"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="EDI / Flux"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextInverseBrush}"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <Button Style="{StaticResource NavSubItem}" Content="Flux entrants"
                                        Command="{Binding OpenTabCommand}" CommandParameter="DEMO_EDI_ENTRANT" />
                                <Button Style="{StaticResource NavSubItem}" Content="Flux sortants"
                                        Command="{Binding OpenTabCommand}" CommandParameter="DEMO_EDI_SORTANT" />
                                <Button Style="{StaticResource NavSubItem}" Content="BODACC"
                                        Command="{Binding OpenTabCommand}" CommandParameter="DEMO_EDI_BODACC" />
                            </StackPanel>
                        </Expander>

                        <!-- ===== PROCÉDURES COLLECTIVES ===== -->
                        <Expander Style="{StaticResource NavGroupExpanderStyle}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{DynamicResource IconClipboard}"
                                          Stroke="{DynamicResource TextInverseBrush}"
                                          StrokeThickness="1.8"
                                          Fill="Transparent"
                                          Width="15" Height="15"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Proc. Collectives"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextInverseBrush}"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <Button Style="{StaticResource NavSubItem}" Content="Dossiers PC"
                                        Command="{Binding OpenTabCommand}" CommandParameter="DEMO_PC_DOSSIER" />
                                <Button Style="{StaticResource NavSubItem}" Content="Créanciers"
                                        Command="{Binding OpenTabCommand}" CommandParameter="DEMO_PC_CREANCIER" />
                            </StackPanel>
                        </Expander>

                        <!-- ===== ADMINISTRATION ===== -->
                        <Expander Style="{StaticResource NavGroupExpanderStyle}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{DynamicResource IconSettings}"
                                          Stroke="{DynamicResource TextInverseBrush}"
                                          StrokeThickness="1.8"
                                          Fill="Transparent"
                                          Width="15" Height="15"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Administration"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextInverseBrush}"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <Button Style="{StaticResource NavSubItem}" Content="Utilisateurs"
                                        Command="{Binding OpenTabCommand}" CommandParameter="DEMO_ADMIN_USER" />
                                <Button Style="{StaticResource NavSubItem}" Content="Greffes"
                                        Command="{Binding OpenTabCommand}" CommandParameter="DEMO_ADMIN_GREFFE" />
                                <Button Style="{StaticResource NavSubItem}" Content="Paramètres"
                                        Command="{Binding OpenTabCommand}" CommandParameter="DEMO_ADMIN_PARAM" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ================ MAIN AREA ================ -->
        <Grid Grid.Column="1">
            <Grid.Resources>
                <BooleanToVisibilityConverter x:Key="BoolToVis" />
            </Grid.Resources>

            <!-- Page d'accueil (Dashboard) visible quand aucun tab n'est ouvert -->
            <ContentControl Content="{Binding Dashboard}"
                            Visibility="{Binding IsHome, Converter={StaticResource BoolToVis}}" />

            <!-- TabControl visible dès qu'on a au moins un tab -->
            <TabControl
                    ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                    Background="{DynamicResource Surface0Brush}"
                    BorderThickness="0"
                    Padding="0"
                    Visibility="{Binding HasTabs, Converter={StaticResource BoolToVis}}">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0,14" />
                    <Setter Property="Margin" Value="0,0,32,0" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Grid>
                                    <Border x:Name="Bd"
                                            Background="Transparent"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter ContentSource="Header"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <Border x:Name="Underline"
                                            Height="3"
                                            VerticalAlignment="Bottom"
                                            CornerRadius="1.5,1.5,0,0"
                                            Background="Transparent" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity"
                                                Value="0.7" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Underline" Property="Background"
                                                Value="{DynamicResource Accent500Brush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Libelle}"
                                   FontSize="{DynamicResource TextSizeSm}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button Margin="12,0,0,0"
                                Width="20" Height="20"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding DataContext.CloseTabCommand,
                                                  RelativeSource={RelativeSource AncestorType=TabControl}}"
                                CommandParameter="{Binding CodeProcessus}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="Transparent"
                                            CornerRadius="10">
                                        <Path Data="{DynamicResource IconCross}"
                                              Stroke="{DynamicResource TextMutedBrush}"
                                              StrokeThickness="1.5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Fill="Transparent"
                                              Width="11" Height="11"
                                              Stretch="Uniform" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource Danger100Brush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
        </TabControl>
        </Grid><!-- /MAIN AREA -->
    </Grid>
</Window>

<UserControl x:Class="Rig.Wpf.Shell.Demo.Views.DemoProcessusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:demo="clr-namespace:Rig.Wpf.Shell.Demo"
             xmlns:views="clr-namespace:Rig.Wpf.Shell.Demo.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource Surface0Brush}">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type demo:DemoListEtape}">
            <views:DemoListEtapeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type demo:DemoSaisieEtape}">
            <views:DemoSaisieEtapeView />
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">

        <!-- ============== HERO HEADER ============== -->
        <Border DockPanel.Dock="Top" Padding="40,32,40,24">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Hero icon -->
                    <Border Grid.Column="0" Style="{StaticResource HeroIconBackdrop}"
                            Width="64" Height="64" CornerRadius="32">
                        <Path Data="{Binding Config.IconKey,
                                Converter={x:Static demo:IconKeyToGeometryConverter.Instance}}"
                              Stroke="{DynamicResource Accent400Brush}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              Width="28" Height="28"
                              Stretch="Uniform" />
                    </Border>

                    <!-- Title block -->
                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Eyebrow}"
                                       Text="{Binding Config.Domain}"
                                       Foreground="{DynamicResource Accent700Brush}" />
                            <Rectangle Width="1" Height="10"
                                       Fill="{DynamicResource Border200Brush}"
                                       Margin="10,0" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Eyebrow}"
                                       Text="{Binding Config.Eyebrow}"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                        <TextBlock FontFamily="{DynamicResource FontFamilyDisplay}"
                                   FontSize="{DynamicResource TextSize3xl}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding Config.Title}"
                                   Margin="0,6,0,0" />
                        <TextBlock Style="{StaticResource BodySecondary}"
                                   Text="{Binding Config.Subtitle}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Toolbar : actions contextuelles + CTA "+ Nouveau" promu -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding Config.ActionsBarre}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GhostButton}"
                                            Content="{Binding}"
                                            Margin="4,0"
                                            ToolTip="Action de démo, sans effet en base." />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Rectangle Width="1" Margin="12,8"
                                   Fill="{DynamicResource Border200Brush}" />
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddCommand}"
                                ToolTip="Créer une nouvelle entrée">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource IconPlus}"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      Fill="Transparent"
                                      Width="14" Height="14"
                                      Stretch="Uniform"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Nouveau" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Stepper Recherche → Saisie -->
                <ItemsControl ItemsSource="{Binding Etapes}" Margin="0,22,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="14" Height="14"
                                        CornerRadius="7"
                                        Background="{DynamicResource Surface1Brush}"
                                        BorderBrush="{DynamicResource Border300Brush}"
                                        BorderThickness="2"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Libelle}"
                                           Margin="10,0,28,0"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource FontFamilyUi}"
                                           FontSize="{DynamicResource TextSizeSm}"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ============== FOOTER SAISIE UNIQUEMENT ============== -->
        <!-- Pas de footer sur l'étape Liste : les actions (Nouveau + toolbar)
             vivent dans le hero header. Sur la Saisie : retour + Save. -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Surface1Brush}"
                BorderBrush="{DynamicResource Border100Brush}"
                BorderThickness="0,1,0,0"
                Padding="40,18"
                Visibility="{Binding IsOnSaisie,
                    Converter={x:Static demo:BoolToVisibilityConverter.Instance}}">
            <Grid>
                <Button HorizontalAlignment="Left"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding BackToListCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{DynamicResource IconChevronLeft}"
                              Stroke="{DynamicResource TextSecondaryBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              Fill="Transparent"
                              Width="12" Height="12"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0" />
                        <TextBlock Text="Retour à la liste" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <StackPanel HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border CornerRadius="999"
                            Padding="14,7"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Success100Brush}"
                            Visibility="{Binding StatusMessage,
                                Converter={x:Static demo:NullToCollapsedConverter.Instance}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0"
                                     Fill="{DynamicResource Success500Brush}" />
                            <TextBlock Text="{Binding StatusMessage}"
                                       VerticalAlignment="Center"
                                       FontFamily="{DynamicResource FontFamilyUi}"
                                       FontSize="{DynamicResource TextSizeSm}"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource Success500Brush}" />
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconSave}"
                                  Stroke="White"
                                  StrokeThickness="1.8"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent"
                                  Width="15" Height="15"
                                  Stretch="Uniform"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Config.SaveLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============== CONTENU ============== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="40,8,40,32">
                <ContentControl Content="{Binding CurrentEtape}" />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>

<UserControl x:Class="Rig.Wpf.Shell.Demo.Views.DemoSaisieEtapeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:demo="clr-namespace:Rig.Wpf.Shell.Demo"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">
    <UserControl.Resources>
        <DataTemplate x:Key="FieldText" DataType="{x:Type demo:DemoField}">
            <StackPanel Margin="0,0,0,16">
                <TextBlock Style="{StaticResource Label}" Text="{Binding Label}" />
                <TextBox FontSize="{DynamicResource TextSizeMd}"
                         Padding="12,9"
                         Background="{DynamicResource Surface1Brush}"
                         BorderBrush="{DynamicResource Border200Brush}"
                         BorderThickness="1"
                         Tag="{Binding Placeholder}" />
                <TextBlock Style="{StaticResource Caption}"
                           Text="{Binding HelperText}"
                           Visibility="{Binding HelperText, Converter={x:Static demo:NullToCollapsedConverter.Instance}}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FieldNumber" DataType="{x:Type demo:DemoField}">
            <StackPanel Margin="0,0,0,16">
                <TextBlock Style="{StaticResource Label}" Text="{Binding Label}" />
                <TextBox FontSize="{DynamicResource TextSizeMd}"
                         Padding="12,9"
                         Background="{DynamicResource Surface1Brush}"
                         BorderBrush="{DynamicResource Border200Brush}"
                         BorderThickness="1"
                         FontFamily="{DynamicResource FontFamilyMono}"
                         Tag="{Binding Placeholder}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FieldMoney" DataType="{x:Type demo:DemoField}">
            <StackPanel Margin="0,0,0,16">
                <TextBlock Style="{StaticResource Label}" Text="{Binding Label}" />
                <Grid>
                    <TextBox FontSize="{DynamicResource TextSizeMd}"
                             Padding="32,9,12,9"
                             Background="{DynamicResource Surface1Brush}"
                             BorderBrush="{DynamicResource Border200Brush}"
                             BorderThickness="1"
                             FontFamily="{DynamicResource FontFamilyMono}"
                             Tag="{Binding Placeholder}" />
                    <TextBlock Text="€"
                               FontFamily="{DynamicResource FontFamilyDisplay}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="12,0,0,0" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FieldCombo" DataType="{x:Type demo:DemoField}">
            <StackPanel Margin="0,0,0,16">
                <TextBlock Style="{StaticResource Label}" Text="{Binding Label}" />
                <ComboBox ItemsSource="{Binding Options}"
                          FontSize="{DynamicResource TextSizeMd}"
                          Padding="12,9"
                          Background="{DynamicResource Surface1Brush}"
                          BorderBrush="{DynamicResource Border200Brush}"
                          BorderThickness="1" />
                <TextBlock Style="{StaticResource Caption}"
                           Text="{Binding HelperText}"
                           Visibility="{Binding HelperText, Converter={x:Static demo:NullToCollapsedConverter.Instance}}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FieldDate" DataType="{x:Type demo:DemoField}">
            <StackPanel Margin="0,0,0,16">
                <TextBlock Style="{StaticResource Label}" Text="{Binding Label}" />
                <DatePicker FontSize="{DynamicResource TextSizeMd}"
                            Background="{DynamicResource Surface1Brush}"
                            BorderBrush="{DynamicResource Border200Brush}"
                            BorderThickness="1"
                            Padding="6,5" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FieldCheck" DataType="{x:Type demo:DemoField}">
            <Border Background="{DynamicResource Surface1Brush}"
                    BorderBrush="{DynamicResource Border100Brush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusMd}"
                    Padding="14,12"
                    Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <CheckBox VerticalAlignment="Center" />
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="{Binding Label}"
                                   FontWeight="SemiBold"
                                   FontSize="{DynamicResource TextSizeMd}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="{Binding HelperText}"
                                   Visibility="{Binding HelperText, Converter={x:Static demo:NullToCollapsedConverter.Instance}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FieldMemo" DataType="{x:Type demo:DemoField}">
            <StackPanel Margin="0,0,0,16">
                <TextBlock Style="{StaticResource Label}" Text="{Binding Label}" />
                <TextBox FontSize="{DynamicResource TextSizeMd}"
                         Padding="12,9"
                         Background="{DynamicResource Surface1Brush}"
                         BorderBrush="{DynamicResource Border200Brush}"
                         BorderThickness="1"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="80"
                         VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </DataTemplate>

        <demo:DemoFieldTemplateSelector x:Key="FieldSelector"
                                       TextTemplate="{StaticResource FieldText}"
                                       NumberTemplate="{StaticResource FieldNumber}"
                                       MoneyTemplate="{StaticResource FieldMoney}"
                                       ComboTemplate="{StaticResource FieldCombo}"
                                       DateTemplate="{StaticResource FieldDate}"
                                       CheckTemplate="{StaticResource FieldCheck}"
                                       MemoTemplate="{StaticResource FieldMemo}" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Fields}"
                      ItemTemplateSelector="{StaticResource FieldSelector}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Margin" Value="0,0,16,0" />
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>
    </ScrollViewer>
</UserControl>

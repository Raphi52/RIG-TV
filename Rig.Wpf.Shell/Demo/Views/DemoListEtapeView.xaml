<UserControl x:Class="Rig.Wpf.Shell.Demo.Views.DemoListEtapeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">
    <UserControl.Resources>
        <!-- Convertit StatusKind ("info"/"success"/"warning"/"error") en brush pour la pastille -->
        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Fill" Value="{DynamicResource Info500Brush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="success">
                    <Setter Property="Fill" Value="{DynamicResource Success500Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="warning">
                    <Setter Property="Fill" Value="{DynamicResource Warning500Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="error">
                    <Setter Property="Fill" Value="{DynamicResource Danger500Brush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barre de filtre -->
        <Border Grid.Row="0"
                Background="{DynamicResource Surface1Brush}"
                CornerRadius="{DynamicResource RadiusMd}"
                BorderBrush="{DynamicResource Border100Brush}"
                BorderThickness="1"
                Padding="14,10"
                Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <Path Data="{DynamicResource IconSearch}"
                      Stroke="{DynamicResource TextMutedBrush}"
                      StrokeThickness="1.6"
                      Fill="Transparent"
                      Width="16" Height="16"
                      Stretch="Uniform"
                      VerticalAlignment="Center"
                      Margin="0,0,10,0" />
                <TextBox Width="320"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="{DynamicResource TextSizeMd}"
                         VerticalContentAlignment="Center"
                         Text="{Binding Filtre, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Rechercher dans la liste..." />
                <Border Width="1" Background="{DynamicResource Border100Brush}"
                        Margin="14,4" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="{DynamicResource TextSizeSm}">
                    <Run Text="{Binding Rows.Count, Mode=OneWay}" /> <Run Text="résultats" />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- DataGrid : on génère les colonnes manuellement en code-behind à partir de Columns -->
        <Border Grid.Row="1"
                Background="{DynamicResource Surface1Brush}"
                CornerRadius="{DynamicResource RadiusLg}"
                BorderBrush="{DynamicResource Border100Brush}"
                BorderThickness="1"
                Effect="{DynamicResource ShadowSm}">
            <DataGrid x:Name="Grid"
                      ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding Selection, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      Background="Transparent"
                      RowBackground="Transparent"
                      AlternatingRowBackground="#FAFBFD"
                      BorderThickness="0"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="46"
                      ColumnHeaderHeight="42"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      IsReadOnly="True">
                <!-- Première colonne : pastille de statut -->
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="40" CanUserSort="False" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Style="{StaticResource StatusDotStyle}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="Rig.Wpf.Processus.Kbis.Views.KbisProcessusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Rig.Wpf.Processus.Kbis"
             xmlns:etapes="clr-namespace:Rig.Wpf.Processus.Kbis.Etapes"
             xmlns:views="clr-namespace:Rig.Wpf.Processus.Kbis.Views"
             d:DataContext="{d:DesignInstance vm:KbisProcessusViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource Surface0Brush}">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type etapes:KbisConsultationEtapeViewModel}">
            <views:KbisConsultationEtapeView />
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">

        <!-- ============== HERO HEADER ============== -->
        <Border DockPanel.Dock="Top" Padding="40,32,40,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource HeroIconBackdrop}"
                        Width="64" Height="64" CornerRadius="32">
                    <Path Data="{DynamicResource IconDocument}"
                          Stroke="{DynamicResource Accent400Brush}"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Fill="Transparent"
                          Width="28" Height="28"
                          Stretch="Uniform" />
                </Border>

                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Eyebrow}"
                                   Text="RCS"
                                   Foreground="{DynamicResource Accent700Brush}" />
                        <Rectangle Width="1" Height="10"
                                   Fill="{DynamicResource Border200Brush}"
                                   Margin="10,0" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Eyebrow}"
                                   Text="EXTRAITS"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                    <TextBlock FontFamily="{DynamicResource FontFamilyDisplay}"
                               FontSize="{DynamicResource TextSize3xl}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding Libelle}"
                               Margin="0,6,0,0" />
                    <TextBlock Style="{StaticResource BodySecondary}"
                               Text="Consultation et émission des extraits K-bis officiels."
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============== CONTENU ============== -->
        <ContentControl Content="{Binding CurrentEtape}" />
    </DockPanel>
</UserControl>

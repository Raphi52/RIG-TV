<UserControl x:Class="Rig.Wpf.Processus.Kbis.Views.KbisConsultationEtapeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:views="clr-namespace:Rig.Wpf.Processus.Kbis.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">
    <Grid Margin="40,0,40,32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- Colonne gauche : recherche + liste résultats + fiche rapide -->
        <Border Grid.Column="0"
                Background="{DynamicResource Surface1Brush}"
                BorderBrush="{DynamicResource Border100Brush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusLg}"
                Effect="{DynamicResource ShadowSm}"
                Padding="18,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Barre de recherche -->
                <Border Grid.Row="0"
                        Background="{DynamicResource Surface0Brush}"
                        CornerRadius="{DynamicResource RadiusMd}"
                        BorderBrush="{DynamicResource Border200Brush}"
                        BorderThickness="1"
                        Padding="12,9">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconSearch}"
                              Stroke="{DynamicResource TextMutedBrush}"
                              StrokeThickness="1.6"
                              Fill="Transparent"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0" />
                        <TextBox Width="280"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="{DynamicResource TextSizeMd}"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding FiltreTexte, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <!-- Compteur résultats -->
                <TextBlock Grid.Row="1" Margin="2,12,0,8"
                           FontSize="{DynamicResource TextSizeSm}"
                           Foreground="{DynamicResource TextMutedBrush}">
                    <Run Text="{Binding Resultats.Count, Mode=OneWay}" />
                    <Run Text="résultats" />
                </TextBlock>

                <!-- Liste résultats -->
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Resultats}"
                         SelectedItem="{Binding Selection, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <TextBlock Text="{Binding Denomination}"
                                           FontWeight="SemiBold"
                                           FontSize="{DynamicResource TextSizeMd}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding Siren}"
                                               FontFamily="{DynamicResource FontFamilyMono}"
                                               FontSize="{DynamicResource TextSizeSm}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Rectangle Width="3" Height="3" Margin="8,0"
                                               Fill="{DynamicResource Border300Brush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding NumGestion}"
                                               FontSize="{DynamicResource TextSizeSm}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Fiche rapide (visible si sélection non nulle) -->
                <Border Grid.Row="3"
                        Background="{DynamicResource Brand50Brush}"
                        CornerRadius="{DynamicResource RadiusMd}"
                        Padding="12,10"
                        Margin="0,10,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Selection}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="FICHE RAPIDE"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Accent700Brush}" />
                        <TextBlock Text="{Binding Selection.Denomination}"
                                   FontWeight="SemiBold"
                                   Margin="0,6,0,0" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="{DynamicResource TextSizeSm}"
                                   Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="{Binding Selection.FormeJuridique}" />
                            <Run Text="·" />
                            <Run Text="SIREN" /><Run Text="{Binding Selection.Siren}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Colonne droite : WebView2 PDF + overlays état -->
        <Border Grid.Column="2"
                Background="{DynamicResource Surface1Brush}"
                BorderBrush="{DynamicResource Border100Brush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusLg}"
                Effect="{DynamicResource ShadowSm}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Toolbar custom (remplace celle d'Edge cachée par #toolbar=0).
                     Actions qui marchent réellement dans le contexte WPF hosté :
                     Imprimer (verb shell "print"), Télécharger (SaveAs),
                     Régénérer (RegenererCommand côté VM). Le menu "···" qui
                     crashait est éliminé. -->
                <Border Grid.Row="0"
                        Background="{DynamicResource Surface0Brush}"
                        BorderBrush="{DynamicResource Border100Brush}"
                        BorderThickness="0,0,0,1"
                        Padding="10,8"
                        Visibility="{Binding PdfFilePath, Converter={x:Static views:NotNullToVisibilityConverter.Instance}}">
                    <Border.Resources>
                    </Border.Resources>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnImprimer" Click="OnPrintClick"
                                Style="{StaticResource GhostButton}"
                                Padding="12,6"
                                ToolTip="Imprimer le PDF">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource IconPrinter}"
                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="1.6"
                                      Fill="Transparent"
                                      Width="14" Height="14"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0" />
                                <TextBlock Text="Imprimer" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnTelecharger" Click="OnDownloadClick"
                                Style="{StaticResource GhostButton}"
                                Margin="4,0,0,0"
                                Padding="12,6"
                                ToolTip="Enregistrer le PDF sous…">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource IconArrowDown}"
                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="1.6"
                                      Fill="Transparent"
                                      Width="14" Height="14"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0" />
                                <TextBlock Text="Télécharger" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Rectangle Width="1" Margin="10,4"
                                   Fill="{DynamicResource Border200Brush}" />

                        <!-- Zoom -/+ et reset -->
                        <Button Click="OnZoomOutClick"
                                Style="{StaticResource GhostButton}"
                                Padding="10,6"
                                ToolTip="Zoom arrière">
                            <TextBlock Text="−"
                                       FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Button>
                        <!-- Affichage du niveau de zoom courant — non cliquable,
                             se met à jour automatiquement via PdfView.ZoomFactorChanged. -->
                        <TextBlock x:Name="ZoomLabel"
                                   Text="100 %"
                                   FontFamily="{DynamicResource FontFamilyMono}"
                                   FontSize="{DynamicResource TextSizeSm}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="6,0"
                                   MinWidth="48"
                                   TextAlignment="Center" />
                        <Button Click="OnZoomInClick"
                                Style="{StaticResource GhostButton}"
                                Padding="10,6"
                                ToolTip="Zoom avant">
                            <TextBlock Text="+"
                                       FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Button>

                        <Rectangle Width="1" Margin="10,4"
                                   Fill="{DynamicResource Border200Brush}" />
                        <Button Command="{Binding RegenererCommand}"
                                Style="{StaticResource GhostButton}"
                                Padding="12,6"
                                ToolTip="Forcer la régénération du PDF (contourner le cache)">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource IconRefresh}"
                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="1.6"
                                      Fill="Transparent"
                                      Width="14" Height="14"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0" />
                                <TextBlock Text="Régénérer" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Visionneuse PDF — masquée tant qu'aucun PDF n'est chargé.
                     WebView2 est un control natif Win32 qui couvre les overlays WPF
                     dans sa zone (airspace) ; le cacher rend visible les overlays
                     "Génération…" et "Erreur" qui sont WPF natifs. -->
                <wv2:WebView2 x:Name="PdfView" Grid.Row="1"
                              Visibility="{Binding PdfFilePath, Converter={x:Static views:NotNullToVisibilityConverter.Instance}}" />

                <!-- Overlay : génération en cours -->
                <Border Grid.Row="1" Background="{DynamicResource Surface1Brush}">
                    <Border.Resources>
                        <BooleanToVisibilityConverter x:Key="BoolToVis" />
                    </Border.Resources>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Génération du K-bis…"
                                   FontFamily="{DynamicResource FontFamilyDisplay}"
                                   FontSize="{DynamicResource TextSizeLg}"
                                   Foreground="{DynamicResource Brand500Brush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Pipeline XML → FO → PDF (~2-3 s)"
                                   FontSize="{DynamicResource TextSizeSm}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Overlay : erreur WebView2 (runtime absent) -->
                <TextBlock x:Name="ErrorMessage"
                           Grid.Row="1"
                           Visibility="Collapsed"
                           Text=""
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="40"
                           Foreground="{DynamicResource Danger500Brush}" />

                <!-- Overlay : erreur génération PDF -->
                <TextBlock Grid.Row="1"
                           Text="{Binding ErreurGeneration}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="40"
                           Foreground="{DynamicResource Danger500Brush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErreurGeneration}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ErreurGeneration}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>

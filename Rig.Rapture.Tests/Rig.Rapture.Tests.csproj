<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests Rapture (import + export JSON). Le code prod vit dans
    Source/RIG/DLL/Processus/PROC_PREAUD/ (export) et PROC_RETAUD/RAPTURE_IMPORT/
    (import) — projets classic csproj (.NET FW), pas SDK-style.

    Stratégie : on LINK les fichiers source standalone (DTO + Parser) qui
    n'ont pas de dépendance RIG, juste System.Runtime.Serialization. Pour les
    couches dépendantes (Mapper/Validator/Apply qui touchent Juge/Instance/etc.),
    on ajoutera plus tard soit du link étendu, soit une ProjectReference vers
    PROC_RETAUD.csproj.

    Directory.Build.props injecte xUnit + FluentAssertions + Moq + SkippableFact
    pour tout projet qui se termine par .Tests.
  -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Rig.Rapture.Tests</RootNamespace>
    <!-- WPF activé pour le test XamlLoad (instancie les UserControls → attrape les XamlParseException runtime
         que dotnet build ne voit pas). Cf. wpf-frontend-terrain. -->
    <UseWPF>true</UseWPF>
    <!--
      Nullable disable : le code Rapture importé par Link est écrit en
      pre-nullable style (string, pas string?). Pour éviter une cascade de
      warnings → errors via TreatWarningsAsErrors hérité de Directory.Build.props,
      on désactive nullable annotations dans ce projet test.
      Le code Rapture lui-même n'est pas modifié (il reste tel quel sur sa branche prod).
    -->
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS8002</NoWarn>
    <!-- SmokeRunner n'est pas signé (FlaUI non-signé) : désactiver signing ici aussi.
         Un assembly strong-named ne peut pas charger un assembly non-signé au runtime. -->
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>

  <!-- Référence framework requise par RaptureImportParser + DTOs (DataContractJsonSerializer) -->
  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <!-- P1 couverture xUnit Mapper/Validator (2026-07-01) — Option C : réf DLL prébuildées AnyCPU/MSIL
       (CorFlags 0x9, chargeables net48 AnyCPU). PAS de ProjectReference PROC_RETAUD (tirerait
       Forms/Crystal/VB6/COM → casse). HintPath sur le bin\Debug du worktree wt-edilot3 (frais = anti-drift
       vs la GAC C:\rig\Bin Dot Net Gac datée 04). Private=true : copie au test-host pour le chargement runtime
       des types RigMetier référencés par Mapper/Validator. -->
  <ItemGroup>
    <Reference Include="RigMetier">
      <HintPath>..\..\wt-edilot3\Source\Outils\DLL\RigMetier\bin\Debug\RigMetier.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="RigTools">
      <HintPath>..\..\wt-edilot3\Source\Outils\DLL\RigTools\bin\Debug\RigTools.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="RigToolsInterface">
      <HintPath>..\..\wt-edilot3\Source\Outils\DLL\RigToolsInterface\bin\Debug\RigToolsInterface.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- check: CS0012 build citait explicitement RigBaseGreffe (classes BASE_GREFFE_PARQUETIER/CODE_PLUMITIF/
         TYPE_PC/TYPE_PATRIMOINE_EI, bases des types METIER) v4.0.2013.80 → réf ajoutée (worktree = même version). -->
    <Reference Include="RigBaseGreffe">
      <HintPath>..\..\wt-edilot3\Source\Outils\DLL\RigBaseGreffe\bin\Debug\RigBaseGreffe.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Source-link du parser + DTO EDI lot3 (worktree wt-edilot3). Standalone : SEULE dépendance =
       System.Runtime.Serialization (ci-dessus). Aucune ProjectReference / DLL RIG (le reste de
       RAPTURE_IMPORT — Mapper/Validator/Apply — touche Juge/Instance et n'est PAS linké ici). -->
  <ItemGroup>
    <Compile Include="..\..\wt-edilot3\Source\RIG\DLL\Processus\PROC_RETAUD\RAPTURE_IMPORT\RaptureImportDto.cs"
             Link="RaptureLot3\RaptureImportDto.cs" />
    <Compile Include="..\..\wt-edilot3\Source\RIG\DLL\Processus\PROC_RETAUD\RAPTURE_IMPORT\RaptureImportParser.cs"
             Link="RaptureLot3\RaptureImportParser.cs" />
    <!-- P1 (2026-07-01) : Mapper + Validator linkés (compilent contre les réf DLL ci-dessus). -->
    <Compile Include="..\..\wt-edilot3\Source\RIG\DLL\Processus\PROC_RETAUD\RAPTURE_IMPORT\RaptureImportMapper.cs"
             Link="RaptureLot3\RaptureImportMapper.cs" />
    <Compile Include="..\..\wt-edilot3\Source\RIG\DLL\Processus\PROC_RETAUD\RAPTURE_IMPORT\RaptureImportValidator.cs"
             Link="RaptureLot3\RaptureImportValidator.cs" />
    <!-- P1 Apply : ApplyService + ses transitifs même-dossier (Diff/NoteAccessor/PCImportService).
         On teste seulement ses HELPERS PURS (ParseDate/SqlStr*/BuildInputsForField) par réflexion ;
         Apply() lui-même (SqlRigConnectionWriteOnly + BD réelle) reste couvert par les smoke tests. -->
    <Compile Include="..\..\wt-edilot3\Source\RIG\DLL\Processus\PROC_RETAUD\RAPTURE_IMPORT\RaptureImportDiff.cs"
             Link="RaptureLot3\RaptureImportDiff.cs" />
    <Compile Include="..\..\wt-edilot3\Source\RIG\DLL\Processus\PROC_RETAUD\RAPTURE_IMPORT\RaptureNoteAccessor.cs"
             Link="RaptureLot3\RaptureNoteAccessor.cs" />
    <Compile Include="..\..\wt-edilot3\Source\RIG\DLL\Processus\PROC_RETAUD\RAPTURE_IMPORT\PCImportService.cs"
             Link="RaptureLot3\PCImportService.cs" />
    <Compile Include="..\..\wt-edilot3\Source\RIG\DLL\Processus\PROC_RETAUD\RAPTURE_IMPORT\RaptureImportApplyService.cs"
             Link="RaptureLot3\RaptureImportApplyService.cs" />
    <!-- NB Chemin B : la machine à états DematRapture (boutons cockpit RAPTUVAL) N'est PAS testée en xUnit ici.
         Le type DematRapture souffre d'un skew d'identité d'assembly dans le test-host (RigMetier/RigBaseGreffe
         worktree vs GAC 28/04 sans les nouveaux types → TypeLoadException runtime ; link source → CS0436 car
         le type est aussi dans la DLL référencée). Couverture assurée à la place par le drive e2e du cockpit
         (raptuval-cockpit : Écarter/Réactiver/Valider via l'UI réelle sur le binaire déployé). -->
  </ItemGroup>

  <!-- Découplage 2026-05-29 : retiré le link du code Rapture LEGACY (Source/RIG/.../RAPTURE_IMPORT
       + PROC_PREAUD/PREAUD) + les fixtures RGPD. Ces tests (dossiers Import/ + Export/) testaient le
       monolithe → ils y restent. RIG-TV ne garde que les tests DU HARNAIS (KbisTextChecks + RaptureUi
       + MlLoop). -->

  <ItemGroup>
    <ProjectReference Include="..\Rig.Wpf.Kbis.SmokeRunner\Rig.Wpf.Kbis.SmokeRunner.csproj" />
    <!-- ML LOOP S1.4 — tests des services ML LOOP de TestViewer (cache + dHash) -->
    <ProjectReference Include="..\Rig.Wpf.Kbis.TestViewer\Rig.Wpf.Kbis.TestViewer.csproj" />
  </ItemGroup>

</Project>

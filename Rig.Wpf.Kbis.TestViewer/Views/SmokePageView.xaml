<UserControl x:Class="Rig.Wpf.Kbis.TestViewer.Views.SmokePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Rig.Wpf.Kbis.TestViewer.Views"
             xmlns:cv="clr-namespace:Rig.Wpf.Kbis.TestViewer.Converters"
             xmlns:vm="clr-namespace:Rig.Wpf.Kbis.TestViewer.ViewModels"
             x:Name="root">
    <!-- Source de vérité UNIQUE du corps d'une page smoke. Édité ici = affecte toutes les catégories. -->
    <!-- Borne la hauteur du corps à la zone VISIBLE du ScrollViewer ancêtre (PageScroll, MainWindow).
         Sans ça, ce ScrollViewer (pan phone/RDP) mesure en hauteur INFINIE → le star-sizing de la Row 1
         ne résout pas → AdaptivePanel + bloc Live (FocusView) mesurent au CONTENU (liste 27 scénarios) et
         s'étirent sur des milliers de px. Avec le MaxHeight = ViewportHeight, le corps tient toujours dans
         la fenêtre (toute résolution) ; le débordement scrolle DANS les panneaux (ListBox/DataGrid). -->
    <Grid Margin="0,12,0,0"
          MaxHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.Resources>
            <!-- Converter local pour masquer Mosaic/List/Footer quand IsFullscreen = true. -->
            <cv:BoolToVisibilityInvertedConverter x:Key="SmokeBoolToVisInv"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Slot header : le module injecte son bandeau (titre + Run + stress, ou BatchControlsView). -->
        <ContentPresenter Grid.Row="0" Content="{Binding HeaderContent, ElementName=root}"/>

        <!-- Corps 3-colonnes PARTAGÉ : Mosaic + Focus + liste.
             Plein écran (FocusContext.IsFullscreen=true) :
               - Col 0 (Mosaic) et Col 2 (liste) disparaissent ; col 1 (Focus) prend tout l'espace.
               - Marge top 12px retirée pour que le PNG soit à zéro du header. -->
        <!-- Corps RESPONSIVE : WrapPanel → côte-à-côte si large, EMPILÉ si étroit (phone). Chaque panneau
             borné en hauteur (MaxHeight) + scroll interne ; MaxWidth → rétrécit sur écran étroit ; le Live
             (Focus) épouse son image. Plein écran : le WrapPanel se cache, un FocusView dédié remplit tout. -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.Resources>
                <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            </Grid.Resources>

            <!-- NORMAL (responsive 2026-06-22 v2) — AdaptivePanel : côte-à-côte pondéré qui REMPLIT la
                 largeur quand large (>= Breakpoint), EMPILÉ verticalement (chacun pleine largeur, hauteur
                 pondérée) quand plus étroit. Weight = part horizontale ET verticale (Focus = héros). Un enfant
                 Collapsed est ignoré (drawer ouvert → liste cachée → Mosaic+Focus remplissent sans trou).
                 Scroll interne des panneaux conservé (ListBox/DataGrid Auto). -->
            <views:AdaptivePanel Breakpoint="1180"
                                 Visibility="{Binding FocusContext.IsFullscreen, ElementName=root, Converter={StaticResource SmokeBoolToVisInv}}">
                <views:MosaicView views:AdaptivePanel.Weight="1.3"
                                  DataContext="{Binding Catalog, ElementName=root}" Margin="0,0,8,8"/>
                <views:FocusView views:AdaptivePanel.Weight="2.4"
                                 DataContext="{Binding FocusContext, ElementName=root}" Margin="0,0,8,8"/>
                <views:ScenarioListView views:AdaptivePanel.Weight="1.6"
                                        DataContext="{Binding Catalog, ElementName=root}" Margin="0,0,0,8">
                    <views:ScenarioListView.Style>
                        <Style TargetType="views:ScenarioListView">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDrawerOpen, ElementName=root}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:ScenarioListView.Style>
                </views:ScenarioListView>
            </views:AdaptivePanel>

            <!-- PLEIN ÉCRAN : Focus remplit toute la zone (le WrapPanel ci-dessus est Collapsed). -->
            <views:FocusView DataContext="{Binding FocusContext, ElementName=root}"
                             Visibility="{Binding FocusContext.IsFullscreen, ElementName=root, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- Footer PARTAGÉ (disk usage). DataContext hérité = MainWindowViewModel.
             Caché en plein écran. -->
        <views:FooterView Grid.Row="2"
                          Visibility="{Binding FocusContext.IsFullscreen, ElementName=root,
                                       Converter={StaticResource SmokeBoolToVisInv},
                                       FallbackValue=Visible}"/>

        <!-- Drawer overlay optionnel (RAPTURE Run History). Span toutes les rows pour couvrir
             toute la hauteur du tab. DrawerContent=null → ContentPresenter vide, invisible.
             IsDrawerOpen pilote la Visibility. -->
        <ContentPresenter Grid.Row="0" Grid.RowSpan="3"
                          Content="{Binding DrawerContent, ElementName=root}"
                          HorizontalAlignment="Right"
                          Width="320"
                          Panel.ZIndex="100"
                          Visibility="{Binding IsDrawerOpen, ElementName=root,
                                       Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"/>
    </Grid>
</UserControl>

<UserControl x:Class="Rig.Wpf.Kbis.TestViewer.Views.RunHistoryDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:Rig.Wpf.Kbis.TestViewer.Converters"
             Width="320" Background="White"
             AutomationProperties.AutomationId="PnlRunHistoryDrawer">
    <UserControl.Resources>
        <cv:BytesToHumanConverter x:Key="BytesToHuman"/>
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F8F8F8" Padding="12,8"
                BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- Bouton fermer (✕) à droite du header. Réutilise la même commande Toggle
                     que le bouton ⏱ Historique du top bar — ferme proprement le drawer. -->
                <Button DockPanel.Dock="Right"
                        Command="{Binding ToggleRunHistoryDrawerCommand}"
                        AutomationProperties.AutomationId="BtnRunHistoryClose"
                        ToolTip="Fermer le drawer"
                        Background="Transparent" BorderThickness="0"
                        Padding="6,2" FontSize="14" FontWeight="Bold" Foreground="#666"
                        Cursor="Hand">
                    ✕
                </Button>
                <TextBlock Text="⏱ Historique des runs (10 derniers)"
                           FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <ListBox ItemsSource="{Binding RunHistoryEntries}" BorderThickness="0"
                 AutomationProperties.AutomationId="ListRunHistory">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8" BorderBrush="#EEE" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="{Binding RunStamp}" FontFamily="Consolas"
                                       FontSize="11" FontWeight="Bold"/>
                            <TextBlock FontSize="10" Foreground="#666">
                                <Run Text="{Binding ScenarioCount, Mode=OneWay}"/><Run Text=" scénarios • "/><Run Text="{Binding Bytes, Mode=OneWay, Converter={StaticResource BytesToHuman}}"/>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="📁 Snaps" Margin="0,0,4,0" Padding="6,2" FontSize="9"
                                        Command="{Binding DataContext.OpenRunHistorySnapsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="▶ Rejouer" Padding="6,2" FontSize="9"
                                        AutomationProperties.AutomationId="{Binding RunStamp, StringFormat='BtnHistoryReplay_{0}'}"
                                        Command="{Binding DataContext.ReplayRunHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>

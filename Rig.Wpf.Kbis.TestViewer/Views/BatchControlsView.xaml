<UserControl x:Class="Rig.Wpf.Kbis.TestViewer.Views.BatchControlsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:Rig.Wpf.Kbis.TestViewer.Converters">
    <!--
        BatchControlsView — Card header de la SmokePageView.
        Phase 6 (extraction). Actuellement DataContext = MainWindowViewModel
        (bindings directs Rapture*). Refactor IBatchControls reporté à plus tard
        (cf. Phase 6.5 quand KBIS sera câblé).

        Sections (5 rows) :
          0. Titre + sous-titre dynamique (SelectedRaptureScenario.Description)
          1. Picker scénario (ComboBox + bouton ↻ Reload)
          2. Expander Avancé (overrides Dossier / Fichier / Audience)
          3. Options (Apply réel / Mode combo / Parallelism) + 5 boutons batch
          4. Status line (RaptureSmokeExeStatus + RaptureSmokeSummary)

        Visibility entière contrôlée par le PARENT (Border Card en plein écran).
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- titre -->
            <RowDefinition Height="Auto"/> <!-- scénario picker -->
            <RowDefinition Height="Auto"/> <!-- avancé expander (dossier + json + audience) -->
            <RowDefinition Height="Auto"/> <!-- options + buttons -->
            <RowDefinition Height="Auto"/> <!-- status line -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Row 0 : titre + sous-titre du scénario -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
            <TextBlock Text="Smoke Import — sélectionner un scénario" Style="{StaticResource H2}"/>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0"
                       Text="{Binding SelectedRaptureScenario.Description, FallbackValue='Choisis un scénario dans la liste : le JSON par défaut et l''audience cible se remplissent auto. Tu peux ensuite override pour tester une variation locale.'}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Row 1 : Scénario picker -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Scénario" Margin="0,12,0,0"
                   VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold"/>
        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" Padding="6,4"
                  ItemsSource="{Binding RaptureScenarios}"
                  SelectedItem="{Binding SelectedRaptureScenario, Mode=TwoWay}"
                  AutomationProperties.AutomationId="CmbRaptureScenario">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                   Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource SecondaryButton}"
                Margin="8,12,0,0" Padding="10,0" Height="32"
                Command="{Binding ReloadRaptureScenariosCommand}"
                ToolTip="Recharge le manifest.json depuis le dossier scenarios.">
            <TextBlock Text="↻"/>
        </Button>

        <!-- Row 2 : Expander Avancé — overrides paths / JSON / audience -->
        <Expander Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0"
                  IsExpanded="False"
                  AutomationProperties.AutomationId="ExpRaptureAdvanced">
            <Expander.Header>
                <TextBlock Text="Avancé — overrides paths / JSON / audience" FontSize="11"
                           Foreground="{StaticResource TextMuted}" FontWeight="SemiBold"/>
            </Expander.Header>
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Dossier" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMuted}" FontWeight="SemiBold"/>
                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4" Padding="6,4"
                         AutomationProperties.AutomationId="TxtRaptureScenariosFolder"
                         Text="{Binding RaptureScenariosFolder, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         FontFamily="Consolas"
                         ToolTip="Dossier contenant manifest.json + les fichiers JSON. Par défaut : RaptureScenarios/ à côté du .exe (embarqué dans le zip). Override possible pour pointer ailleurs."/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Fichier" Margin="0,6,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMuted}" FontWeight="SemiBold"/>
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Padding="6,4"
                         AutomationProperties.AutomationId="TxtRaptureJsonOverride"
                         Text="{Binding RaptureScenarioJsonPathOverride, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         FontFamily="Consolas"
                         ToolTip="JSON utilisé pour ce run. Auto-rempli depuis le scénario sélectionné. Override pour pointer un fichier custom."/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="Audience" Margin="0,6,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMuted}" FontWeight="SemiBold"/>
                <TextBox Grid.Row="1" Grid.Column="4" Margin="0,6,0,0" Padding="6,4"
                         AutomationProperties.AutomationId="TxtRaptureAudienceOverride"
                         Text="{Binding RaptureScenarioAudienceIdOverride, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         FontFamily="Consolas"
                         ToolTip="AUDNC_ID cible (override). Auto-rempli depuis le scénario sélectionné. Si vide, l'orchestrator résout l'audience par date+heure du header JSON."/>
            </Grid>
        </Expander>

        <!-- Row 3 : Options + Buttons Start/Pause/Stop
             NB : la case "Accepter création audience" a été retirée. acceptCreate=true
             est désormais default côté SmokeRunner (la popup "Audience non trouvée" est
             traitée auto + cleanup SQL si Cas C). Pour refuser explicitement la création,
             ajouter "no-create" aux args (cas rare, non-exposé en UI). -->
        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal"
                    Margin="0,14,0,0" VerticalAlignment="Center">
            <CheckBox IsChecked="{Binding RaptureSmokeApplyReal, Mode=TwoWay}"
                      VerticalAlignment="Center"
                      AutomationProperties.AutomationId="ChkRaptureApplyReal"
                      ToolTip="Si coché, le smoke clique 'Importer (N champs cochés)' au lieu d'Annuler → ApplyService écrit réellement en base. Le SmokeRunner snapshot APPEL_AFFAIRE+NOTE_PROCEDURE AVANT et restore APRÈS pour rester net-zero. Requiert un AUDNC_ID renseigné dans le champ Audience.">
                <CheckBox.Content>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Apply réel via UI" FontWeight="SemiBold" Foreground="#B02A37"/>
                        <TextBlock Text=" — clique Importer + restore SQL net-zero"
                                   Foreground="{StaticResource TextSecondary}" Margin="4,0,0,0"/>
                    </StackPanel>
                </CheckBox.Content>
            </CheckBox>
            <!-- ChkRaptureVisibleMode est CONSERVÉ comme hidden bound au Mode combo pour backwards-compat des drive scripts. -->
            <CheckBox IsChecked="{Binding RaptureSmokeVisibleMode, Mode=TwoWay}"
                      AutomationProperties.AutomationId="ChkRaptureVisibleMode"
                      Visibility="Collapsed"/>

            <!-- Nouveau : Mode combo box (P2) -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <TextBlock Text="Mode" Margin="0,0,6,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" FontSize="11"/>
                <ComboBox Width="180"
                          AutomationProperties.AutomationId="CmbRaptureMode"
                          ItemsSource="{Binding RaptureModeOptions}"
                          SelectedValuePath="Mode"
                          SelectedValue="{Binding SelectedRaptureMode, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          ToolTip="Mode de visibilité du batch — voir tooltip des items pour le détail."/>
            </StackPanel>

            <!-- Nouveau : Parallelism numeric input -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <TextBlock Text="Parall." Margin="0,0,6,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" FontSize="11"/>
                <TextBox Width="40" Padding="4,2"
                         AutomationProperties.AutomationId="NumRaptureParallelism"
                         Text="{Binding RaptureParallelism, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         ToolTip="Nombre de workers RIG en parallèle (1-16)."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        DockPanel.Dock="Right" Margin="20,0,0,0">
                <StackPanel.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                        <Setter Property="Height" Value="34"/>
                        <Setter Property="MinWidth" Value="80"/>
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="Margin" Value="6,0,0,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </StackPanel.Resources>
                <Button Command="{Binding ResetSmokeDbCommand}"
                        AutomationProperties.AutomationId="BtnRaptureResetDb"
                        ToolTip="RESET DB : panic restore SQL pour clean slate. Restaure les APPEL_AFFAIRE depuis l'audit, supprime les NOTE_PROCEDURE RAPTURE_* écrites par smoke, et les Cas C audiences leftover (date >= 2027). À utiliser quand tu veux rejouer les mêmes scénarios depuis zéro.">
                    <TextBlock Text="🗑  Reset DB" Foreground="#B02A37"/>
                </Button>
                <Button Command="{Binding ToggleRunHistoryDrawerCommand}"
                        AutomationProperties.AutomationId="BtnRaptureHistoryToggle"
                        ToolTip="Ouvre/ferme le drawer Historique des runs récents.">
                    <TextBlock Text="⏱  Historique" Foreground="#06f"/>
                </Button>
                <Button Command="{Binding TogglePauseRaptureSmokeCommand}"
                        AutomationProperties.AutomationId="BtnRapturePause"
                        ToolTip="PAUSE / REPRENDRE : gèle (ou dégèle) instantanément tout l'arbre de process (FlaUI + RIG legacy + smoke).">
                    <TextBlock Text="{Binding RaptureSmokePauseLabel}"/>
                </Button>
                <Button Command="{Binding StopRaptureSmokeCommand}"
                        AutomationProperties.AutomationId="BtnRaptureStop"
                        ToolTip="STOP : tue l'arbre de process du run en cours. Irréversible — relancer depuis le début.">
                    <TextBlock Text="⏹  Stop" Foreground="#B02A37"/>
                </Button>
                <Button Style="{StaticResource PrimaryButton}"
                        Height="34" MinWidth="120" Padding="16,0" Margin="6,0,0,0"
                        VerticalContentAlignment="Center"
                        Command="{Binding RunRaptureProcessE2ECommand}"
                        AutomationProperties.AutomationId="BtnRaptureProcessE2E"
                        ToolTip="START E2E : lance RIG legacy via FlaUI → Login → PROC_RETAUD → audience (ID override sinon date+heure du JSON) → click 'Importer Rapture' → recap. N'APPLIQUE PAS en base (Annuler).">
                    <TextBlock Text="▶  Start E2E"/>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Row 4 : Status line -->
        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
            <TextBlock Text="{Binding RaptureSmokeExeStatus}" Style="{StaticResource MonoMuted}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding RaptureSmokeSummary}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>

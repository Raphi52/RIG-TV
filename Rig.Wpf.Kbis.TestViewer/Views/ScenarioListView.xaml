<UserControl x:Class="Rig.Wpf.Kbis.TestViewer.Views.ScenarioListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:Rig.Wpf.Kbis.TestViewer.Converters"
             xmlns:vm="clr-namespace:Rig.Wpf.Kbis.TestViewer.ViewModels">
    <UserControl.Resources>
        <cv:VerdictToColorConverter x:Key="VerdictToColor"/>
        <cv:PhaseToStringConverter x:Key="PhaseToString"/>
        <cv:StringToVisibilityConverter x:Key="StringToVisibility"/>
    </UserControl.Resources>
    <!-- Phase 5 refactor : DataContext = IScenarioCatalog (RaptureCatalog adapter).
         ItemsSource = ScenariosView (vue triée Queued à la fin).
         SelectedItem TwoWay sur SelectedScenario (forwarded au BatchRunState par l'adapter). -->
    <DataGrid ItemsSource="{Binding ScenariosView}"
              SelectedItem="{Binding SelectedScenario, Mode=TwoWay}"
              AutomationProperties.AutomationId="GridRaptureScenarios"
              AutoGenerateColumns="False"
              CanUserAddRows="False" CanUserDeleteRows="False"
              GridLinesVisibility="Horizontal"
              HeadersVisibility="Column"
              IsReadOnly="True"
              SelectionMode="Single"
              RowDetailsVisibilityMode="VisibleWhenSelected"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
                <Setter Property="AutomationProperties.AutomationId" Value="{Binding Id, StringFormat='ScenarioRow_{0}'}"/>
            </Style>
        </DataGrid.RowStyle>
        <DataGrid.Columns>
            <DataGridTextColumn Header="Scenario ID" Binding="{Binding Id}" Width="2*"/>
            <DataGridTextColumn Header="Phase" Binding="{Binding Phase, Converter={StaticResource PhaseToString}}" Width="*"/>
            <DataGridTextColumn Header="Durée" Binding="{Binding Duration, StringFormat=mm\\:ss}" Width="60"/>
            <DataGridTextColumn Header="PID" Binding="{Binding WorkerPid}" Width="60"/>
            <DataGridTextColumn Header="Verdict" Binding="{Binding Verdict}" Width="80">
                <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{Binding Verdict, Converter={StaticResource VerdictToColor}}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
        </DataGrid.Columns>
        <DataGrid.RowDetailsTemplate>
            <DataTemplate>
                <!-- Drawer inline déployé sous la row sélectionnée. AutomationId préservé pour
                     drive scripts. MaxHeight 600 (avant 320) pour ~55 lignes visibles vs 30.
                     TextBlock HorizontalAlignment="Left" : empêche le héritage Stretch du StackPanel
                     parent qui force TextBlock à la largeur du ScrollViewer → trimming "…" à droite.
                     Avec Left, TextBlock s'auto-size à son contenu → dépasse en largeur → ScrollViewer
                     auto kick in horizontale scrollbar. Lignes worker font 80-495 chars (moy 119),
                     drawer ~70 chars visibles ; sans ce fix, ~41% perdu à droite en moyenne. -->
                <Border Background="{StaticResource ConsoleSurface}" Margin="20,4,20,8" Padding="8" CornerRadius="3"
                        AutomationProperties.AutomationId="{Binding Id, StringFormat='DrawerScenario_{0}'}">
                    <StackPanel>
                        <!-- ── STEPS ── liste pré-définie des steps internes du scenario (KBIS VK/XEX)
                             avec leur status temps-réel (Passed/Failed/Pending). Format :
                             "STEP N  ✓  Label  ·  Passed" avec icons colorés (vert/rouge/gris).
                             Visible uniquement si Steps.Count > 0 (cas Rapture: empty → collapsed). -->
                        <TextBlock Text="🎯 STEPS"
                                   Foreground="{StaticResource ConsoleStepFg}" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"
                                   Visibility="{Binding Steps.Count, Converter={x:Static vm:CountToVisibilityConverter.Instance}, FallbackValue=Collapsed}"/>
                        <ItemsControl ItemsSource="{Binding Steps}" Margin="0,0,0,8"
                                      AutomationProperties.AutomationId="{Binding Id, StringFormat='DrawerSteps_{0}'}"
                                      Visibility="{Binding Steps.Count, Converter={x:Static vm:CountToVisibilityConverter.Instance}, FallbackValue=Collapsed}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>   <!-- "STEP N" -->
                                            <ColumnDefinition Width="22"/>   <!-- icon -->
                                            <ColumnDefinition Width="*"/>    <!-- label -->
                                            <ColumnDefinition Width="70"/>   <!-- Outcome label -->
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource ConsoleFaintFg}"
                                                   Text="{Binding StepNumber, StringFormat='STEP {0}'}"/>
                                        <TextBlock Grid.Column="1" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"
                                                   Text="{Binding Outcome, Converter={x:Static vm:OutcomeToIconConverter.Instance}}"
                                                   Foreground="{Binding Outcome, Converter={x:Static vm:OutcomeToBrushConverter.Instance}}"/>
                                        <TextBlock Grid.Column="2" FontSize="10" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding ShortLabel}" Foreground="{StaticResource ConsoleFaintFg}"
                                                   ToolTip="{Binding FullDescription}"/>
                                        <TextBlock Grid.Column="3" FontSize="9" FontStyle="Italic" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding OutcomeLabel}"
                                                   Foreground="{Binding Outcome, Converter={x:Static vm:OutcomeToBrushConverter.Instance}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="📋 Logs (rolling 500 lines)"
                                   Foreground="{StaticResource ConsoleDimFg}" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                        <!-- TextBox readonly au lieu de TextBlock-in-ScrollViewer : TextBox a son
                             ScrollViewer interne natif qui gère bien le scroll H/V avec NoWrap.
                             Le workaround TextBlock + HorizontalAlignment=Left ne fait PAS apparaître
                             la scrollbar horizontale (vérifié par screenshot 2026-05-27 : TextBlock
                             se mesure avec la largeur du ScrollViewer → pas de débordement détecté). -->
                        <!-- HorizontalAlignment Stretch + MaxWidth 440 explicite : sans MaxWidth,
                             le TextBox prend infinite available width pendant Measure → TextWrapping
                             ne wrap pas. 440 = col 3 (500) - marges drawer Border (20+20) - padding (8+8)
                             - safety pour scrollbar verticale + marges DataGrid. Pas de side-scroll. -->
                        <TextBox Text="{Binding LogsTail, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Foreground="{StaticResource ConsoleTermFg}" Background="{StaticResource ConsoleSurface}"
                                 BorderThickness="0"
                                 FontFamily="Consolas" FontSize="9"
                                 TextWrapping="Wrap"
                                 HorizontalAlignment="Stretch"
                                 MaxWidth="440"
                                 MaxHeight="600"
                                 HorizontalScrollBarVisibility="Disabled"
                                 VerticalScrollBarVisibility="Auto"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                    Visibility="{Binding FailScreenshotPath, Converter={StaticResource StringToVisibility}, FallbackValue=Collapsed}">
                            <TextBlock Text="📸 FAIL screenshot : " Foreground="{StaticResource ConsoleDimFg}" FontSize="9"/>
                            <TextBlock Text="{Binding FailScreenshotPath}" Foreground="{StaticResource ConsoleTermFg}" FontFamily="Consolas" FontSize="9"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </DataGrid.RowDetailsTemplate>
    </DataGrid>
</UserControl>

<Window x:Class="Rig.Wpf.Kbis.TestViewer.Views.GlobalSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres globaux — Rig Testing"
        Height="700" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgWindow}"
        FontFamily="Segoe UI" FontSize="13"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="PARAMÈTRES GLOBAUX" FontSize="11" FontWeight="Bold"
                       Foreground="{StaticResource TextSecondary}" Margin="0,0,0,2"/>
            <TextBlock Text="⚙ Configuration de Rig Testing"
                       FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>
        </StackPanel>

        <!-- Section : Parallelism -->
        <Border Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"
                Padding="0,12,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Parallelism (instances RIG simultanées)"
                           FontWeight="SemiBold" FontSize="14"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{Binding ElementName=ParallelismSlider, Path=Value, StringFormat='{}{0:F0}'}"
                           FontWeight="Bold" FontSize="16"
                           Foreground="{StaticResource Gold}" MinWidth="40"
                           HorizontalAlignment="Right"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="Nombre max de workers RigClientAccueil lancés en parallèle par le batch 'All scenarios'. Au-delà de 16, le focus stealing UIA peut faire dérailler les drivers FlaUI."
                           TextWrapping="Wrap" FontSize="11"
                           Foreground="{StaticResource TextSecondary}" Margin="0,4,0,12"/>

                <Slider x:Name="ParallelismSlider" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                        Minimum="1" Maximum="32" TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        TickPlacement="BottomRight"
                        Value="{Binding Parallelism, Mode=TwoWay}"
                        AutomationProperties.AutomationId="SliderParallelism"/>
            </Grid>
        </Border>

        <!-- Section : Screenshots-loop -->
        <Border Grid.Row="2" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"
                Padding="0,12,0,16">
            <StackPanel>
                <CheckBox IsChecked="{Binding ScreenshotsLoopEnabled, Mode=TwoWay}"
                          AutomationProperties.AutomationId="ChkScreenshotsLoop">
                    <CheckBox.Content>
                        <StackPanel>
                            <TextBlock Text="Screenshots-loop activés" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Permet aux agents IA d'écrire des screenshots intermédiaires dans Audit\screenshots-loop\ (règle 16 CLAUDE.md)."
                                       TextWrapping="Wrap" FontSize="11"
                                       Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox.Content>
                </CheckBox>
            </StackPanel>
        </Border>

        <!-- Section : Headless mode (RIG_DRIVER_HEADLESS env var) -->
        <Border Grid.Row="3" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"
                Padding="0,12,0,16">
            <StackPanel>
                <CheckBox IsChecked="{Binding HeadlessMode, Mode=TwoWay}"
                          AutomationProperties.AutomationId="ChkHeadlessMode">
                    <CheckBox.Content>
                        <StackPanel>
                            <TextBlock Text="Mode headless (RIG sur desktop séparé invisible)"
                                       FontWeight="SemiBold" FontSize="14"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Quand coché (default), les RigClientAccueil lancés par les workers --legacy-rapture-process tournent sur un Desktop Windows séparé (HDESK), invisibles à l'utilisateur. Décocher pour VOIR les N instances RIG s'ouvrir à l'écran (focus stealing pendant le test). Propagé via env var RIG_DRIVER_HEADLESS=0/1 aux workers."
                                       TextWrapping="Wrap" FontSize="11"
                                       Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox.Content>
                </CheckBox>
            </StackPanel>
        </Border>

        <!-- Section : Test result cache (ML LOOP Phase 4) -->
        <Border Grid.Row="4" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"
                Padding="0,12,0,16">
            <StackPanel>
                <CheckBox IsChecked="{Binding UseTestResultCache, Mode=TwoWay}"
                          AutomationProperties.AutomationId="ChkUseTestResultCache">
                    <CheckBox.Content>
                        <StackPanel>
                            <TextBlock Text="🗄 Cache de résultats E2E (ML LOOP Phase 4)"
                                       FontWeight="SemiBold" FontSize="14"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Memoize (hash binaire SmokeRunner + JSON scénario) → status. Sur cache-hit PASS, skip l'exécution du worker — gain massif sur les itérations cosmétiques. ATTENTION : peut masquer une régression si l'invalidation rate un fichier influent (rare car le hash inclut la totalité de SmokeRunner.exe)."
                                       TextWrapping="Wrap" FontSize="11"
                                       Foreground="{StaticResource TextSecondary}" Margin="0,2,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding CacheStatsSummary}"
                                           FontSize="11" FontFamily="Consolas"
                                           Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center"/>
                                <Button Content="Vider le cache"
                                        Margin="12,0,0,0" Padding="8,2"
                                        Click="ClearCache_Click"
                                        AutomationProperties.AutomationId="BtnClearCache"/>
                            </StackPanel>
                        </StackPanel>
                    </CheckBox.Content>
                </CheckBox>
            </StackPanel>
        </Border>

        <!-- Spacer + path info -->
        <StackPanel Grid.Row="5" VerticalAlignment="Bottom" Margin="0,16,0,0">
            <TextBlock Text="Fichier de configuration :" FontSize="10"
                       Foreground="{StaticResource TextSecondary}"/>
            <TextBlock Text="{Binding FilePath}" FontFamily="Consolas" FontSize="11"
                       Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Annuler" Style="{StaticResource SecondaryButton}"
                    Width="100" Height="34" Margin="0,0,8,0"
                    Click="Cancel_Click"
                    AutomationProperties.AutomationId="BtnSettingsCancel"/>
            <Button Content="Enregistrer" Style="{StaticResource PrimaryButton}"
                    Width="120" Height="34"
                    Click="Save_Click"
                    AutomationProperties.AutomationId="BtnSettingsSave"/>
        </StackPanel>
    </Grid>
</Window>

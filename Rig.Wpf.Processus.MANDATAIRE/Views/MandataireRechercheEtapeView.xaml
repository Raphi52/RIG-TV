<UserControl x:Class="Rig.Wpf.Processus.Mandataire.Views.MandataireRechercheEtapeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:etapes="clr-namespace:Rig.Wpf.Processus.Mandataire.Etapes"
             xmlns:views="clr-namespace:Rig.Wpf.Processus.Mandataire.Views"
             d:DataContext="{d:DesignInstance etapes:MandataireRechercheEtapeViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" Inverse="False" />
        <views:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Inverse="True" />
    </UserControl.Resources>

    <Border Style="{StaticResource Card}" Padding="0">
        <DockPanel LastChildFill="True">

            <!-- ============== TOOLBAR ============== -->
            <Border DockPanel.Dock="Top"
                    BorderBrush="{DynamicResource Border100Brush}"
                    BorderThickness="0,0,0,1"
                    Padding="28,24">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Heading2}"
                                       Text="Annuaire des mandataires" />
                            <TextBlock Style="{StaticResource BodySecondary}"
                                       Text="Recherchez parmi les mandataires inscrits au tableau de votre greffe."
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Style="{StaticResource PillAccent}"
                                Padding="12,5"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6"
                                         Fill="{DynamicResource Accent500Brush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Resultats.Count}"
                                           FontFamily="{DynamicResource FontFamilyMono}"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Foreground="{DynamicResource Accent700Brush}"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="résultats"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Accent700Brush}"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="420" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBox x:Name="FilterBox"
                                     Padding="44,10,14,10"
                                     Text="{Binding FiltreTexte,
                                           UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                     ToolTip="Filtrer par nom ou abrégé" />
                            <Path Data="{DynamicResource IconSearch}"
                                  Stroke="{DynamicResource TextMutedBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="14,0,0,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False" />
                            <TextBlock Text="Rechercher par nom ou abrégé..."
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="44,0,14,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FiltreTexte}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FiltreTexte}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <CheckBox Grid.Column="2"
                                  Content="Inclure les inactifs"
                                  IsChecked="{Binding InclureInactifs}"
                                  VerticalAlignment="Center" />

                        <Button Grid.Column="4"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding RefreshCommand}"
                                ToolTip="Rafraîchir la liste">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource IconRefresh}"
                                      Stroke="{DynamicResource Brand500Brush}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      Width="14" Height="14"
                                      Stretch="Uniform"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Rafraîchir" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============== DATAGRID + EMPTY STATE ============== -->
            <Grid>
                <DataGrid x:Name="ResultatsGrid"
                          ItemsSource="{Binding Resultats}"
                          SelectedItem="{Binding MandataireSelectionne, Mode=TwoWay}"
                          Margin="16,8,16,16">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CIV." Binding="{Binding Civilite}" Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextSecondaryBrush}" />
                                    <Setter Property="FontFamily"
                                            Value="{DynamicResource FontFamilyMono}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="NOM" Binding="{Binding Nom}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="FontSize" Value="14" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextPrimaryBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="ABRÉGÉ" Binding="{Binding Abrege}" Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="FontFamily"
                                            Value="{DynamicResource FontFamilyMono}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextSecondaryBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="N° CNBF" Binding="{Binding NumeroCnbf}" Width="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="FontFamily"
                                            Value="{DynamicResource FontFamilyMono}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextSecondaryBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="STATUT" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Border Style="{StaticResource PillSuccess}"
                                                HorizontalAlignment="Left"
                                                Padding="10,3"
                                                Visibility="{Binding EstActif,
                                                    Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6"
                                                         Fill="{DynamicResource Success500Brush}"
                                                         VerticalAlignment="Center" />
                                                <TextBlock Text="Actif"
                                                           FontSize="{DynamicResource TextSizeXs}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Success500Brush}"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Pill}"
                                                HorizontalAlignment="Left"
                                                Padding="10,3"
                                                Visibility="{Binding EstActif,
                                                    Converter={StaticResource InverseBoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6"
                                                         Fill="{DynamicResource TextMutedBrush}"
                                                         VerticalAlignment="Center" />
                                                <TextBlock Text="Inactif"
                                                           FontSize="{DynamicResource TextSizeXs}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty state somptueux -->
                <Border Background="{DynamicResource Surface1Brush}"
                        Padding="48"
                        Margin="16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Resultats.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="96" Height="96"
                                CornerRadius="48"
                                Background="{DynamicResource HeroIconGradient}"
                                HorizontalAlignment="Center"
                                Effect="{DynamicResource ShadowLg}">
                            <Path Data="{DynamicResource IconSearch}"
                                  Stroke="{DynamicResource Accent400Brush}"
                                  StrokeThickness="2.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="Transparent"
                                  Width="42" Height="42"
                                  Stretch="Uniform" />
                        </Border>
                        <TextBlock Style="{StaticResource Heading2}"
                                   Text="Aucun mandataire trouvé"
                                   HorizontalAlignment="Center"
                                   Margin="0,24,0,8" />
                        <TextBlock Style="{StaticResource BodySecondary}"
                                   Text="Affinez votre recherche ou cochez « Inclure les inactifs »."
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>

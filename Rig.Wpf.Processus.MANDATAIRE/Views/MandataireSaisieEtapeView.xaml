<UserControl x:Class="Rig.Wpf.Processus.Mandataire.Views.MandataireSaisieEtapeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:etapes="clr-namespace:Rig.Wpf.Processus.Mandataire.Etapes"
             xmlns:views="clr-namespace:Rig.Wpf.Processus.Mandataire.Views"
             d:DataContext="{d:DesignInstance etapes:MandataireSaisieEtapeViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" Inverse="False" />
        <views:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Inverse="True" />
    </UserControl.Resources>

    <Grid MaxWidth="960" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============== INTRO (hero card) ============== -->
        <Border Grid.Row="0" Style="{StaticResource CardIntro}" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource HeroIconBackdropAccent}"
                        Width="64" Height="64" CornerRadius="32">
                    <Path Data="{DynamicResource IconUser}"
                          Stroke="White"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Fill="Transparent"
                          Width="30" Height="30"
                          Stretch="Uniform" />
                </Border>

                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Eyebrow}"
                               Text="INSCRIPTION AU TABLEAU"
                               Foreground="{DynamicResource Accent700Brush}" />
                    <TextBlock Style="{StaticResource Heading2}"
                               Text="Informations du mandataire"
                               Margin="0,4,0,0" />
                    <TextBlock Style="{StaticResource BodySecondary}"
                               Text="Renseignez les informations obligatoires pour valider l'inscription au tableau."
                               Margin="0,4,0,0" />
                </StackPanel>

                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Border Style="{StaticResource PillSuccess}"
                            Padding="12,5"
                            Visibility="{Binding IsValid,
                                Converter={StaticResource BoolToVisibility}}"
                            Effect="{DynamicResource GlowAccent}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconCheck}"
                                  Stroke="{DynamicResource Success500Brush}"
                                  StrokeThickness="2.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent"
                                  Width="13" Height="13"
                                  Stretch="Uniform"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Prêt à enregistrer"
                                       FontWeight="SemiBold"
                                       FontSize="{DynamicResource TextSizeSm}"
                                       Foreground="{DynamicResource Success500Brush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PillWarning}"
                            Padding="12,5"
                            Visibility="{Binding IsValid,
                                Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconWarning}"
                                  Stroke="{DynamicResource Warning500Brush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="Transparent"
                                  Width="13" Height="13"
                                  Stretch="Uniform"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Champs requis"
                                       FontWeight="SemiBold"
                                       FontSize="{DynamicResource TextSizeSm}"
                                       Foreground="{DynamicResource Warning500Brush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ============== SECTION 1 : IDENTITÉ ============== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,20">
            <StackPanel>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                            Background="{DynamicResource Brand50Brush}"
                            VerticalAlignment="Top">
                        <TextBlock Text="01"
                                   FontFamily="{DynamicResource FontFamilyMono}"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="{DynamicResource Brand500Brush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Style="{StaticResource Heading3}" Text="Identité" />
                        <TextBlock Style="{StaticResource BodySecondary}"
                                   Text="Civilité et patronyme tels qu'enregistrés au tableau."
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Label}" Text="Civilité" />
                            <TextBlock Text=" *"
                                       Foreground="{DynamicResource Danger500Brush}"
                                       FontWeight="Bold" />
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding CivilitesDisponibles}"
                                  SelectedItem="{Binding Civilite,
                                      UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Label}" Text="Nom" />
                            <TextBlock Text=" *"
                                       Foreground="{DynamicResource Danger500Brush}"
                                       FontWeight="Bold" />
                        </StackPanel>
                        <TextBox x:Name="NomBox"
                                 Text="{Binding Nom,
                                        UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                            Background="{DynamicResource Surface2Brush}"
                            CornerRadius="{DynamicResource RadiusMd}"
                            Padding="14,10"
                            Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconInfo}"
                                  Stroke="{DynamicResource Info500Brush}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  Fill="Transparent"
                                  Width="14" Height="14"
                                  Stretch="Uniform"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Personne morale : indiquer « PM » en civilité et la raison sociale en nom."
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ============== SECTION 2 : IDENTIFIANTS ============== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,20">
            <StackPanel>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                            Background="{DynamicResource Brand50Brush}"
                            VerticalAlignment="Top">
                        <TextBlock Text="02"
                                   FontFamily="{DynamicResource FontFamilyMono}"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="{DynamicResource Brand500Brush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Style="{StaticResource Heading3}" Text="Identifiants" />
                        <TextBlock Style="{StaticResource BodySecondary}"
                                   Text="Abrégé interne et numéro CNBF (facultatifs)."
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource Label}" Text="Abrégé" />
                        <TextBox Text="{Binding Abrege,
                                      UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{DynamicResource FontFamilyMono}" />
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="3 à 6 lettres, utilisé dans les éditions."
                                   Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Label}" Text="N° CNBF" />
                        <TextBox Text="{Binding NumeroCnbf,
                                      UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{DynamicResource FontFamilyMono}" />
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="Conseil National des Barreaux de France."
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ============== SECTION 3 : STATUT ============== -->
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <StackPanel>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                            Background="{DynamicResource Brand50Brush}"
                            VerticalAlignment="Top">
                        <TextBlock Text="03"
                                   FontFamily="{DynamicResource FontFamilyMono}"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="{DynamicResource Brand500Brush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Style="{StaticResource Heading3}" Text="Statut" />
                        <TextBlock Style="{StaticResource BodySecondary}"
                                   Text="Inscription active ou suspendue."
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <Border Background="{DynamicResource Surface2Brush}"
                        CornerRadius="{DynamicResource RadiusLg}"
                        Padding="20,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Body}"
                                       FontWeight="SemiBold"
                                       Text="Mandataire actif" />
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Les mandataires inactifs sont masqués dans la recherche par défaut."
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding EstActif}"
                                  VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

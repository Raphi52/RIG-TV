<UserControl x:Class="Rig.Wpf.Processus.Mandataire.Views.MandataireProcessusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Rig.Wpf.Processus.Mandataire"
             xmlns:etapes="clr-namespace:Rig.Wpf.Processus.Mandataire.Etapes"
             xmlns:views="clr-namespace:Rig.Wpf.Processus.Mandataire.Views"
             d:DataContext="{d:DesignInstance vm:MandataireProcessusViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource Surface0Brush}">
    <UserControl.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" Inverse="False" />
        <views:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Inverse="True" />
        <views:ReferenceEqualsConverter x:Key="ReferenceEquals" />
        <DataTemplate DataType="{x:Type etapes:MandataireRechercheEtapeViewModel}">
            <views:MandataireRechercheEtapeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type etapes:MandataireSaisieEtapeViewModel}">
            <views:MandataireSaisieEtapeView />
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">

        <!-- ============== HERO HEADER ============== -->
        <Border DockPanel.Dock="Top" Padding="40,32,40,28">
            <StackPanel>
                <!-- Eyebrow + titre + sous-titre + hero icon -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Hero icon -->
                    <Border Grid.Column="0" Style="{StaticResource HeroIconBackdrop}"
                            Width="64" Height="64" CornerRadius="32">
                        <Path Data="{DynamicResource IconBriefcase}"
                              Stroke="{DynamicResource Accent400Brush}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              Width="28" Height="28"
                              Stretch="Uniform" />
                    </Border>

                    <!-- Title block -->
                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Eyebrow}"
                                       Text="JUDICIAIRE"
                                       Foreground="{DynamicResource Accent700Brush}" />
                            <Rectangle Width="1" Height="10"
                                       Fill="{DynamicResource Border200Brush}"
                                       Margin="10,0" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Eyebrow}"
                                       Text="MANDATAIRE"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                        <TextBlock FontFamily="{DynamicResource FontFamilyDisplay}"
                                   FontSize="{DynamicResource TextSize3xl}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding Libelle}"
                                   Margin="0,6,0,0" />
                        <TextBlock Style="{StaticResource BodySecondary}"
                                   Text="Inscription, recherche et tenue du tableau des mandataires judiciaires."
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Badge id mandataire -->
                    <Border Grid.Column="2"
                            Style="{StaticResource PillAccent}"
                            VerticalAlignment="Center"
                            Padding="14,7"
                            Visibility="{Binding IdMandataire,
                                Converter={x:Static views:IntToVisibilityConverter.WhenZeroCollapsed}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="DOSSIER #"
                                       Foreground="{DynamicResource Accent700Brush}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding IdMandataire}"
                                       Foreground="{DynamicResource Accent700Brush}"
                                       FontFamily="{DynamicResource FontFamilyMono}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Stepper somptueux : ligne entre pastilles -->
                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl ItemsSource="{Binding Etapes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="14" Height="14"
                                            CornerRadius="7"
                                            Background="{DynamicResource Surface1Brush}"
                                            BorderBrush="{DynamicResource Border300Brush}"
                                            BorderThickness="2"
                                            VerticalAlignment="Center">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#1F3B66"
                                                              ShadowDepth="0"
                                                              BlurRadius="0"
                                                              Opacity="0" />
                                        </Border.Effect>
                                    </Border>
                                    <TextBlock Text="{Binding Libelle}"
                                               Margin="10,0,28,0"
                                               VerticalAlignment="Center"
                                               FontFamily="{DynamicResource FontFamilyUi}"
                                               FontSize="{DynamicResource TextSizeSm}"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ============== FOOTER ============== -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Surface1Brush}"
                BorderBrush="{DynamicResource Border100Brush}"
                BorderThickness="0,1,0,0"
                Padding="40,18">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource GhostButton}"
                            Command="{Binding GoPreviousCommand}"
                            AutomationProperties.Name="Précédent"
                            ToolTip="Étape précédente">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconChevronLeft}"
                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent"
                                  Width="14" Height="14"
                                  Stretch="Uniform"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Précédent" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}"
                            Command="{Binding GoNextCommand}"
                            Margin="4,0,0,0"
                            AutomationProperties.Name="Suivant"
                            ToolTip="Étape suivante">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Suivant" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Path Data="{DynamicResource IconChevronRight}"
                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent"
                                  Width="14" Height="14"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Margin="20,8"
                               Fill="{DynamicResource Border100Brush}" />
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding NouveauMandataireCommand}"
                            AutomationProperties.Name="Nouveau mandataire">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconPlus}"
                                  Stroke="{DynamicResource Brand500Brush}"
                                  StrokeThickness="2.2"
                                  StrokeStartLineCap="Round"
                                  Fill="Transparent"
                                  Width="14" Height="14"
                                  Stretch="Uniform"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Nouveau mandataire" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- Pill de feedback Save : visible uniquement quand le VM a
                         remonté un StatusMessage (succès, warning ou erreur).
                         Couleurs background/foreground dérivées de StatusKind. -->
                    <Border CornerRadius="999"
                            Padding="14,7"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center"
                            x:Name="StatusPill"
                            Background="{Binding StatusKind,
                                Converter={x:Static views:StatusKindToBrushConverter.Background}}"
                            Visibility="{Binding StatusMessage,
                                Converter={x:Static views:StringToVisibilityConverter.WhenEmptyCollapsed}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0"
                                     Fill="{Binding StatusKind,
                                         Converter={x:Static views:StatusKindToBrushConverter.Foreground}}" />
                            <TextBlock Text="{Binding StatusMessage}"
                                       VerticalAlignment="Center"
                                       FontFamily="{DynamicResource FontFamilyUi}"
                                       FontSize="{DynamicResource TextSizeSm}"
                                       FontWeight="Medium"
                                       Foreground="{Binding StatusKind,
                                           Converter={x:Static views:StatusKindToBrushConverter.Foreground}}" />
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource PrimaryButton}"
                            x:Name="SaveButton"
                            AutomationProperties.Name="Enregistrer"
                            Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconSave}"
                                  Stroke="White"
                                  StrokeThickness="1.8"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent"
                                  Width="15" Height="15"
                                  Stretch="Uniform"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Enregistrer le mandataire"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============== CONTENU ============== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="40,8,40,32">
                <ContentControl Content="{Binding CurrentEtape}" />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>

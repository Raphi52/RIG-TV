<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Rig.Wpf.RigMetier.Legacy</RootNamespace>
    <NoWarn>$(NoWarn);MSB3277;CS8002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rig.Wpf.Core\Rig.Wpf.Core.csproj" />
    <ProjectReference Include="..\Rig.Wpf.RigMetier\Rig.Wpf.RigMetier.csproj" />
  </ItemGroup>

  <!--
    Références aux DLL legacy déployées (C:\rig\Bin Dot Net Gac\).
    Le projet ne build que sur un poste où le legacy est provisionné.
    Au runtime, RigMetier dépend aussi de RIG_BinC_Common.dll (P-invoke C++)
    qu'il faut résoudre via SetDllDirectory(@"C:\rig\BinC") avant tout appel.
  -->
  <ItemGroup>
    <Reference Include="RigMetier">
      <HintPath>C:\rig\Bin Dot Net Gac\RigMetier.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="RigTools">
      <HintPath>C:\rig\Bin Dot Net Gac\RigTools.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="AmiSystem">
      <HintPath>C:\rig\Bin Dot Net Gac\AmiSystem.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="RigBaseGreffe">
      <HintPath>C:\rig\Bin Dot Net Gac\RigBaseGreffe.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="RigKBIS">
      <HintPath>C:\rig\Bin Dot Net Gac\RigKBIS.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="RigToolsInterface">
      <HintPath>C:\rig\Bin Dot Net Gac\RigToolsInterface.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
  </ItemGroup>

</Project>
